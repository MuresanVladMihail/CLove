# Object files
*.o
*.ko
*.obj
*.elf
*.py[cod]

#Editors
*~
*.swp
*.swo

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
tags

# OS specific files
.DS_Store

# cmake output folder (anchored to the repo root: an unanchored "build/"
# also matched vendored source directories such as
# src/3rdparty/glew/build/cmake, silently keeping them out of the repo)
/build/
/cmake-build-*/

# cmake build files - top level only, so vendored *.txt.in and friends survive
/*.txt.*

# local backup of the old GLEW copy (see CLAUDE.md)
/glew-old/

# compiled engine binary (no extension on Linux/macOS) - covers stray
# builds left inside example/game directories during local testing
/opt/examples/**/clove

# The 2D editor example writes its work next to itself: scene.json is whatever
# level is open, editor.json the grid step and the rest of its settings. Both
# are the user's, not the example's - the editor seeds a starting scene in code
# when there is no file, and a committed one would carry absolute sprite paths
# from whichever machine saved it.
/opt/examples/fh/editor/*.json

# JetBrains IDE project state
.idea/
