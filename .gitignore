# Object files
*.o
*.ko
*.obj
*.elf
*.py[cod]

#Editors
*~
*.swp
*.swo

# Precompiled Headers
*.gch
*.pch

# Libraries
*.lib
*.a
*.la
*.lo

# Shared objects (inc. Windows DLLs)
*.dll
*.so
*.so.*
*.dylib

# Executables
*.exe
*.out
*.app
*.i*86
*.x86_64
*.hex

# Debug files
*.dSYM/
tags

# OS specific files
.DS_Store

# cmake output folder - anchored to the repository root on purpose: an
# unanchored "build/" also matched vendored directories such as
# src/3rdparty/glew/build/, so glew's own CMake files never made it into the
# repository and a fresh clone could not configure.
/build/
/cmake-build-*/

# cmake build files - top level only, so vendored *.txt.in and friends survive
/*.txt.*

# local backup of the old GLEW copy (see CLAUDE.md)
glew-old/

# compiled engine binary (no extension on Linux/macOS) - covers stray
# builds left inside example/game directories during local testing
/opt/examples/**/clove

# JetBrains IDE project state
.idea/
