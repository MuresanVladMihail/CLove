# Syntax definition for CLove game scripts.
# https://github.com/MuresanVladMihail/CLove
#
# CLove games are written in FH, so this syntax inherits the whole FH grammar
# and only adds recognition of the engine's `love_*` API. It therefore requires
# the FH package (tools/Sublime/FH in the FH repository) to be installed as
# Packages/FH.
#
# See http://www.sublimetext.com/docs/syntax.html
name: CLove
scope: source.fh.clove
version: 2
extends: Packages/FH/FH.sublime-syntax

file_extensions:
  - fh

variables:
  # Every function in the `c_funcs[]` table of a src/fhapi/<module>.c, grouped
  # by the `love_<area>_` prefix, plus the callbacks the engine looks up by
  # name. Regenerate with `python3 tools/Sublime/CLove/update_api.py`.
  # >>> GENERATED by update_api.py -- do not edit by hand <<<
