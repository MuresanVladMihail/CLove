  clove_api: '{{clove_graphics}}|{{clove_geometry}}|{{clove_image}}|{{clove_quad}}|{{clove_font}}|{{clove_mesh}}|{{clove_shader}}|{{clove_particlesystem}}|{{clove_window}}|{{clove_audio}}|{{clove_keyboard}}|{{clove_mouse}}|{{clove_timer}}|{{clove_math}}|{{clove_filesystem}}|{{clove_ui}}|{{clove_event}}|{{clove_misc}}'
  # >>> END GENERATED <<<

contexts:

  # Replaces FH's `prototype`, so the CLove API is recognised everywhere FH
  # itself looks for comments -- that is, everywhere except inside strings and
  # comments, which opt out with `meta_include_prototype: false`.
  #
  # Prototype rules are tried before a context's own rules, so an API name wins
  # over FH's generic `function-call` / `identifiers` rules. A definition such
  # as `fn love_draw(self)` still matches FH's `function-definition` first,
  # because that rule starts earlier on the line, and so keeps its
  # `entity.name.function.fh` scope and its place in the symbol list.
  prototype:
    - include: clove-api
    - include: comments

  clove-api:
    - match: '\b(?:{{clove_callback}})\b'
      scope: support.function.callback.clove
    - match: '\b(?:{{clove_api}})\b'
      scope: support.function.clove
