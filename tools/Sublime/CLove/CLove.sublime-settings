{
	// Settings applied to every file using the CLove syntax.
	// (Commenting is driven by the FH package's Comments.tmPreferences, which
	// applies here too: source.fh.clove matches its source.fh selector.)
	"tab_size": 4,
	"translate_tabs_to_spaces": true,
	"auto_complete_selector": "source.fh - comment - string",
	"ensure_newline_at_eof_on_save": true
}
