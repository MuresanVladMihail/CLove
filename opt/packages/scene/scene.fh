# ============================================================================
#  scene.fh -- read and query a scene authored in the CLove 2D editor
# ----------------------------------------------------------------------------
#  include "path/to/scene.fh"
#
#  fn love_load() {
#      let scene = Scene("levels/forest.json");
#
#      let player = scene.find("Player");
#      let pos = scene.position(player);
#
#      let pickups = scene.in_group("pickups");
#      let speed = scene.prop(player, "speed", 60);
#      let under_cursor = scene.at_point(mx, my);
#  }
#
#  The editor writes a document; this package is the read side of it, so game
#  code never has to know the JSON layout. Entities are addressed by their
#  stable `id` or looked up by name or group -- the same way you would reach
#  for a node in Godot, minus anything to do with scripts attached to them.
#
#  Everything here is pure data: no engine calls, so it runs headless and is
#  cheap to test. Turning a scene into live images and Box2D bodies is a
#  separate concern and stays in the caller.
#
#  A scene is read once and not watched: reload it yourself if the file
#  changes underneath you.
#
#  Version 2 documents also carry a tile map -- the spritesheets the level was
#  painted from and the cells painted out of them. Version 1 ones do not, and
#  read back as a map with no sheets and no cells rather than as an error.
# ============================================================================

let SCENE_SUPPORTED_VERSION = 2;

# ---------------------------------------------------------------------------
#  Scene(source)
#
#  `source` is either a path to a .json file the editor saved, or a document
#  map you already parsed. Raises on a missing file or a document this package
#  is too old to read -- a level that will not load is a bug, not a state the
#  caller should have to poll for.
# ---------------------------------------------------------------------------
fn Scene(source) {
	let doc = source;

	if (type(source) == "string") {
		if (io_filetype(source) != "file") {
			error("Scene(): no such scene file: " + source);
		}
		let file = io_open(source, "r");
		let text = io_read(file);
		io_close(file);
		doc = json_parse(text);
	}

	if (type(doc) != "map") {
		error("Scene(): expected a file path or a document map");
	}
	if (!contains_key(doc, "version")) {
		error("Scene(): this is not a scene document (no version field)");
	}
	if (doc.version > SCENE_SUPPORTED_VERSION) {
		error("Scene(): document version " + doc.version +
			" is newer than this package understands (" + SCENE_SUPPORTED_VERSION + ")");
	}
	if (!contains_key(doc, "entities")) {
		doc.entities = [];
	}

	let scene = {};

	# --- the document itself ------------------------------------------

	scene.raw = fn() { return doc; };
	scene.version = fn() { return doc.version; };

	# Pixels per Box2D metre the level was authored at. Feed it to
	# love_physics_setMeter() before building a world, or distances come out
	# wrong by exactly this ratio.
	scene.meter = fn() {
		if (contains_key(doc, "meter")) { return doc.meter; }
		return 30;
	};

	scene.gravity = fn() {
		if (contains_key(doc, "gravity")) { return doc.gravity; }
		return [0, 900];
	};

	# --- reading one entity -------------------------------------------
	#
	#  Accessors rather than raw field access, so a later change to the
	#  document layout does not reach into every game that reads a level.

	scene.id = fn(e) { return e.id; };
	scene.name = fn(e) { return e.name; };
	scene.is_visible = fn(e) { return e.visible; };
	scene.position = fn(e) { return [e.transform.x, e.transform.y]; };
	scene.angle = fn(e) { return e.transform.angle; };
	scene.color = fn(e) { return e.color; };

	scene.fixture = fn(e) { return e.fixtures[0]; };

	# Box2D's collision filter as [category, mask, group] -- what this thing is,
	# what it is willing to touch, and the group override. Named for LOVE's
	# fixture:getFilterData() rather than "filter", which below is the
	# predicate query and got there first. Older levels that predate the field
	# read as "layer 1, hits everything", which is Box2D's own default.
	scene.filter_data = fn(e) {
		let f = e.fixtures[0];
		let category = 1;
		let mask = 65535;
		let group = 0;
		if (contains_key(f, "category")) { category = f.category; }
		if (contains_key(f, "mask")) { mask = f.mask; }
		if (contains_key(f, "group")) { group = f.group; }
		return [category, mask, group];
	};
	scene.size = fn(e) { return [e.fixtures[0].w, e.fixtures[0].h]; };

	scene.center = fn(e) {
		return [e.transform.x + e.fixtures[0].w * 0.5,
		        e.transform.y + e.fixtures[0].h * 0.5];
	};

	# [min_x, min_y, max_x, max_y], ignoring rotation
	scene.rect = fn(e) {
		return [e.transform.x, e.transform.y,
		        e.transform.x + e.fixtures[0].w,
		        e.transform.y + e.fixtures[0].h];
	};

	scene.body_type = fn(e) { return e.body.type; };

	# The path the artwork was authored with, or null. Load it with
	# love_graphics_newImage(): it takes .svg and .png through the same call,
	# and love_image_isVector() tells them apart afterwards.
	scene.sprite_path = fn(e) {
		if (e.sprite == null) { return null; }
		if (!contains_key(e.sprite, "path")) { return null; }
		if (len(e.sprite.path) == 0) { return null; }
		return e.sprite.path;
	};

	# The rectangle of that image the entity actually draws, [x, y, w, h], when
	# its artwork is one tile of a spritesheet -- null when it is the whole
	# file. Turn it into something drawable with love_graphics_newQuad(x, y, w,
	# h, image width, image height) and pass that to love_graphics_draw()
	# before the position.
	scene.sprite_quad = fn(e) {
		if (e.sprite == null) { return null; }
		if (!contains_key(e.sprite, "quad")) { return null; }
		if (e.sprite.quad == null || len(e.sprite.quad) != 4) { return null; }
		return e.sprite.quad;
	};

	scene.groups = fn(e) {
		if (!contains_key(e, "groups")) { return []; }
		return e.groups;
	};

	scene.has_group = fn(e, group) {
		let gs = scene.groups(e);
		for (let i = 0; i < len(gs); i++) {
			if (gs[i] == group) { return true; }
		}
		return false;
	};

	# Whatever the level author put on this entity that the editor has no
	# field for: a patrol radius, a door's target level, what a pickup is
	# worth. Values keep the type they were authored with, so `p.speed * dt`
	# works without converting anything.
	#
	#     let p = scene.props(e);
	#     let speed = scene.prop(e, "speed", 60);
	#
	# Groups say what a thing is, props say with what parameters. Between them
	# a game keeps its behaviour in code and the level stays data.
	scene.props = fn(e) {
		if (!contains_key(e, "props")) { return {}; }
		return e.props;
	};

	# One property, with a fallback -- a level authored before the property
	# existed should not be a crash.
	scene.prop = fn(e, key, fallback) {
		let p = scene.props(e);
		if (!contains_key(p, key)) { return fallback; }
		return p[key];
	};

	scene.has_prop = fn(e, key) {
		return contains_key(scene.props(e), key);
	};

	# Named references to other entities: a door's exit, a lever's target. The
	# document holds ids; this hands back the entity, because that is what the
	# caller wanted and an id it has to look up itself is a chore with a bug in
	# it. null when the name is not set -- the editor drops a link whose target
	# is deleted, so a dangling one should not exist in a file it wrote.
	scene.links = fn(e) {
		if (!contains_key(e, "links")) { return {}; }
		return e.links;
	};

	scene.link = fn(e, name) {
		let ls = scene.links(e);
		if (!contains_key(ls, name)) { return null; }
		return scene.get(ls[name]);
	};

	# --- looking entities up ------------------------------------------

	scene.all = fn() { return doc.entities; };
	scene.count = fn() { return len(doc.entities); };

	scene.get = fn(id) {
		for (let i = 0; i < len(doc.entities); i++) {
			if (doc.entities[i].id == id) { return doc.entities[i]; }
		}
		return null;
	};

	# First match, or null. Names are not unique -- use find_all() when that
	# matters, or an id when you need to be certain.
	scene.find = fn(name) {
		for (let i = 0; i < len(doc.entities); i++) {
			if (doc.entities[i].name == name) { return doc.entities[i]; }
		}
		return null;
	};

	scene.find_all = fn(name) {
		let out = [];
		for (let i = 0; i < len(doc.entities); i++) {
			if (doc.entities[i].name == name) { append(out, doc.entities[i]); }
		}
		return out;
	};

	# Everything tagged with a group, in document order.
	scene.in_group = fn(group) {
		let out = [];
		for (let i = 0; i < len(doc.entities); i++) {
			if (scene.has_group(doc.entities[i], group)) {
				append(out, doc.entities[i]);
			}
		}
		return out;
	};

	# Every group name used anywhere in the scene, without duplicates.
	scene.group_names = fn() {
		let out = [];
		for (let i = 0; i < len(doc.entities); i++) {
			let gs = scene.groups(doc.entities[i]);
			for (let g = 0; g < len(gs); g++) {
				let seen = false;
				for (let k = 0; k < len(out); k++) {
					if (out[k] == gs[g]) { seen = true; }
				}
				if (!seen) { append(out, gs[g]); }
			}
		}
		return out;
	};

	scene.filter = fn(predicate) {
		let out = [];
		for (let i = 0; i < len(doc.entities); i++) {
			if (predicate(doc.entities[i])) { append(out, doc.entities[i]); }
		}
		return out;
	};

	# --- joints -------------------------------------------------------
	#
	# A joint holds two entities together and belongs to neither, so it lives
	# at the top level and names them by id. Build them after the bodies:
	# both ends have to exist first.

	scene.joints = fn() {
		if (!contains_key(doc, "joints")) { return []; }
		return doc.joints;
	};

	scene.joints_of = fn(e) {
		let out = [];
		let all = scene.joints();
		for (let i = 0; i < len(all); i++) {
			if (all[i].a == e.id || all[i].b == e.id) { append(out, all[i]); }
		}
		return out;
	};


	# --- the tile map -------------------------------------------------
	#
	#  A level's ground, painted rather than placed: the sheets it was painted
	#  from, and the cells. A cell is [tileset id, column, row] -- where the
	#  tile is *in the sheet*, so nothing here depends on how wide the image
	#  file happens to be.
	#
	#  Drawing one, in outline:
	#
	#      let size = scene.tile_size();
	#      let sheets = {};
	#      for (let i = 0; i < len(scene.tilesets()); i++) {
	#          let ts = scene.tilesets()[i];
	#          sheets["" + ts.id] = love_graphics_newImage(ts.path);
	#      }
	#      let cells = scene.tile_cells(layer);
	#      for (let i = 0; i < len(cells); i++) {
	#          let c = cells[i];
	#          let ts = scene.tileset(c[2]);
	#          let src = scene.tile_source(ts, c[3], c[4]);
	#          let img = sheets["" + ts.id];
	#          let quad = love_graphics_newQuad(src[0], src[1], src[2], src[3],
	#              love_image_getWidth(img), love_image_getHeight(img));
	#          love_graphics_draw(img, quad, c[0] * size[0], c[1] * size[1]);
	#      }
	#
	#  Build the quads once, not per frame -- and a love_graphics_newBatch()
	#  is what you want for a map of any size.

	scene.tilemap = fn() {
		if (!contains_key(doc, "tilemap")) {
			return { "tile_w": 32, "tile_h": 32, "layers": [] };
		}
		return doc.tilemap;
	};

	# [width, height] of one cell, in world units. A sheet whose tiles are a
	# different size is scaled onto it, which is what the editor draws.
	scene.tile_size = fn() {
		let m = scene.tilemap();
		return [m.tile_w, m.tile_h];
	};

	scene.tilesets = fn() {
		if (!contains_key(doc, "tilesets")) { return []; }
		return doc.tilesets;
	};

	scene.tileset = fn(id) {
		let sets = scene.tilesets();
		for (let i = 0; i < len(sets); i++) {
			if (sets[i].id == id) { return sets[i]; }
		}
		return null;
	};

	# Where a tile sits in its sheet, in pixels: [x, y, w, h]. The same
	# arithmetic the editor draws with, and the reason a cell can name a
	# column and a row instead of an index.
	scene.tile_source = fn(ts, tx, ty) {
		let margin = 0;
		let spacing = 0;
		if (contains_key(ts, "margin")) { margin = ts.margin; }
		if (contains_key(ts, "spacing")) { spacing = ts.spacing; }
		return [margin + tx * (ts.tile_w + spacing),
		        margin + ty * (ts.tile_h + spacing),
		        ts.tile_w, ts.tile_h];
	};

	# Back first: the layers are in draw order, the way the entities are.
	scene.tile_layers = fn() {
		let m = scene.tilemap();
		if (!contains_key(m, "layers")) { return []; }
		return m.layers;
	};

	scene.tile_layer = fn(name) {
		let layers = scene.tile_layers();
		for (let i = 0; i < len(layers); i++) {
			if (layers[i].name == name) { return layers[i]; }
		}
		return null;
	};

	# Every painted cell of a layer, as [column, row, tileset id, tile column,
	# tile row]. An array rather than the document's map, because the map is
	# keyed by "column,row" as text and unpacking that is this package's job,
	# not the caller's. Unordered -- a map has no order to give.
	scene.tile_cells = fn(layer) {
		let out = [];
		if (layer == null || !contains_key(layer, "cells")) { return out; }

		let k = next_key(layer.cells, null);
		while (k != null) {
			let parts = string_split(k, ",");
			if (len(parts) == 2) {
				let cell = layer.cells[k];
				append(out, [tonumber(parts[0]), tonumber(parts[1]),
				             cell[0], cell[1], cell[2]]);
			}
			k = next_key(layer.cells, k);
		}
		return out;
	};

	scene.tile_count = fn(layer) {
		if (layer == null || !contains_key(layer, "cells")) { return 0; }
		return len(layer.cells);
	};

	# What is painted in one cell, as [tileset id, tile column, tile row], or
	# null when nothing is.
	scene.tile_at = fn(layer, cx, cy) {
		if (layer == null || !contains_key(layer, "cells")) { return null; }
		let key = "" + cx + "," + cy;
		if (!contains_key(layer.cells, key)) { return null; }
		return layer.cells[key];
	};

	# World point -> the cell covering it, and a cell -> the rectangle it
	# covers. math_floor, not truncation: x = -1 is in cell -1.
	scene.tile_cell_at = fn(x, y) {
		let size = scene.tile_size();
		return [math_floor(x / size[0]), math_floor(y / size[1])];
	};

	scene.tile_rect = fn(cx, cy) {
		let size = scene.tile_size();
		return [cx * size[0], cy * size[1], size[0], size[1]];
	};

	# [min_x, min_y, max_x, max_y] over every painted cell, or null when
	# nothing is painted.
	scene.tile_bounds = fn() {
		let size = scene.tile_size();
		let layers = scene.tile_layers();
		let found = false;
		let b = [0, 0, 0, 0];

		for (let i = 0; i < len(layers); i++) {
			let cells = scene.tile_cells(layers[i]);
			for (let c = 0; c < len(cells); c++) {
				let x = cells[c][0] * size[0];
				let y = cells[c][1] * size[1];
				if (!found) {
					found = true;
					b = [x, y, x + size[0], y + size[1]];
				} else {
					if (x < b[0]) { b[0] = x; }
					if (y < b[1]) { b[1] = y; }
					if (x + size[0] > b[2]) { b[2] = x + size[0]; }
					if (y + size[1] > b[3]) { b[3] = y + size[1]; }
				}
			}
		}
		if (!found) { return null; }
		return b;
	};

	# The collision the layers marked solid stand for, as [x, y, w, h] in world
	# units, with each row of touching cells merged into one rectangle. Hand
	# them to love_physics_newRectangleShape() on static bodies.
	#
	# The merge is here rather than shared with the editor because this package
	# deliberately depends on nothing: a game reads a level with scene.fh alone.
	scene.solid_tile_rects = fn() {
		let size = scene.tile_size();
		let layers = scene.tile_layers();
		let out = [];

		for (let i = 0; i < len(layers); i++) {
			let layer = layers[i];
			let solid = contains_key(layer, "solid") && layer.solid;
			if (!solid) { continue; }

			# gather each row's columns, sort them, then merge the runs
			let rows = {};
			let cells = scene.tile_cells(layer);
			for (let c = 0; c < len(cells); c++) {
				let row = "" + cells[c][1];
				if (!contains_key(rows, row)) { rows[row] = []; }
				append(rows[row], cells[c][0]);
			}

			let row = next_key(rows, null);
			while (row != null) {
				let cols = rows[row];
				for (let a = 1; a < len(cols); a++) {
					let v = cols[a];
					let k = a - 1;
					while (k >= 0 && cols[k] > v) {
						cols[k + 1] = cols[k];
						k = k - 1;
					}
					cols[k + 1] = v;
				}

				let start = 0;
				let prev = 0;
				let open = false;
				for (let a = 0; a < len(cols); a++) {
					if (!open) {
						start = cols[a];
						prev = cols[a];
						open = true;
					} else if (cols[a] == prev + 1) {
						prev = cols[a];
					} else if (cols[a] != prev) {
						append(out, [start * size[0], tonumber(row) * size[1],
						             (prev - start + 1) * size[0], size[1]]);
						start = cols[a];
						prev = cols[a];
					}
				}
				if (open) {
					append(out, [start * size[0], tonumber(row) * size[1],
					             (prev - start + 1) * size[0], size[1]]);
				}
				row = next_key(rows, row);
			}
		}
		return out;
	};

	# --- spatial queries ----------------------------------------------
	#
	#  Axis-aligned and rotation-agnostic: they test the fixture box as the
	#  editor lays it out. Good enough to pick a spawn point or find what is
	#  near something; use the physics world for anything exact.

	# Topmost first, matching what a click in the editor would select.
	scene.at_point = fn(x, y) {
		let out = [];
		for (let i = len(doc.entities) - 1; i >= 0; i = i - 1) {
			let r = scene.rect(doc.entities[i]);
			if (x >= r[0] && x <= r[2] && y >= r[1] && y <= r[3]) {
				append(out, doc.entities[i]);
			}
		}
		return out;
	};

	scene.in_rect = fn(x, y, w, h) {
		let out = [];
		for (let i = 0; i < len(doc.entities); i++) {
			let r = scene.rect(doc.entities[i]);
			if (r[0] < x + w && r[2] > x && r[1] < y + h && r[3] > y) {
				append(out, doc.entities[i]);
			}
		}
		return out;
	};

	scene.nearest = fn(x, y) {
		let best = null;
		let best_d = -1.0;
		for (let i = 0; i < len(doc.entities); i++) {
			let c = scene.center(doc.entities[i]);
			let dx = c[0] - x;
			let dy = c[1] - y;
			let d = dx * dx + dy * dy;
			if (best_d < 0.0 || d < best_d) {
				best_d = d;
				best = doc.entities[i];
			}
		}
		return best;
	};

	# [min_x, min_y, max_x, max_y] over the whole scene, or null when empty.
	scene.bounds = fn() {
		if (len(doc.entities) == 0) { return null; }
		let r = scene.rect(doc.entities[0]);
		let minx = r[0];
		let miny = r[1];
		let maxx = r[2];
		let maxy = r[3];
		for (let i = 1; i < len(doc.entities); i++) {
			let b = scene.rect(doc.entities[i]);
			if (b[0] < minx) { minx = b[0]; }
			if (b[1] < miny) { miny = b[1]; }
			if (b[2] > maxx) { maxx = b[2]; }
			if (b[3] > maxy) { maxy = b[3]; }
		}
		return [minx, miny, maxx, maxy];
	};

	return scene;
}
