# ============================================================================
#  panels.fh -- the toolbar, hierarchy, console, status bar and theme window
# ----------------------------------------------------------------------------
#  A docked panel passes notitle + noresize + noclose, which is what makes it
#  fixed; the Theme editor deliberately omits them to show an ordinary microui
#  window.
#
#  Two microui rules the code here has to respect:
#
#   * A slider, number field or text box takes its widget id from the address
#     it is handed, which is the same stack slot on every call -- so each one
#     needs an explicit id, or they collide and none of them respond.
#   * mu_get_container() hashes a popup's name together with the top of the id
#     stack, so love_ui_open_popup() and love_ui_begin_popup() must be called
#     from the same enclosing window. Opening inside a panel and beginning
#     outside it silently addresses two different containers.
# ============================================================================


fn panels_dock_opts(app) {
	return love_ui_opt("notitle") + love_ui_opt("noresize") + love_ui_opt("noclose");
}

# Begins a docked panel at a rect that is recomputed every frame.
#
# love_ui_begin_window()'s rect is applied only the first time microui sees
# that window -- which is what makes a floating window stay where it was
# dragged, and what left the docks pinned to whatever size the editor started
# at. Setting the rect first is the whole of following a resized window, and
# doing both here means the two can never drift apart.
fn panels_dock(app, name, x, y, w, h) {
	love_ui_setWindowRect(name, x, y, w, h);
	return love_ui_begin_window(name, x, y, w, h, panels_dock_opts(app));
}

# --- toolbar --------------------------------------------------------

fn panels_primitives_menu(app) {
	# opened and begun inside the same window, see the note above
	# The label names the primitive this menu would drop, and only that: with
	# the Tiles tool up it used to read "Primitive: tile", which is neither
	# what the menu holds nor what the tool does.
	let label = "Primitives";
	if (app.tool == "rect" || app.tool == "circle" || app.tool == "polygon") {
		label = "Primitive: " + app.tool;
	}
	if (love_ui_button(label, ALIGN_CENTER)) {
		love_ui_open_popup("primitives");
	}

	# closed from out here rather than from inside the body: the popup's own
	# container is on top of the id stack in there, so the name would hash to
	# something else -- same note as in scenes_menu()
	let close_menu = false;

	if (love_ui_begin_popup("primitives")) {
		love_ui_layout_row(1, [110], 0);
		if (love_ui_button("Rect", ALIGN_LEFT)) {
			app.tool = "rect";
			log_line(app, "tool: rect");
			close_menu = true;
		}
		if (love_ui_button("Circle", ALIGN_LEFT)) {
			app.tool = "circle";
			log_line(app, "tool: circle");
			close_menu = true;
		}
		if (love_ui_button("Polygon", ALIGN_LEFT)) {
			app.tool = "polygon";
			app.draft = [];
			log_line(app, "tool: polygon -- click points, Return closes it");
			close_menu = true;
		}
		love_ui_end_popup();
	}

	if (close_menu) { love_ui_setWindowOpen("primitives", false); }

	# asked after the fact, and from the window that opened it: begin_popup()
	# still answers true on the frame the popup is being dismissed
	if (love_ui_popup_open("primitives")) { app.popup_open = true; }
	return 0;
}

# The view and snapping switches, behind one button. They are settings, not
# actions: they belong together and out of the way, rather than spread along
# the toolbar next to the things you press all day.
#
# Opened and begun from the same window, since mu_get_container() hashes a
# popup's name with the top of the id stack.
fn panels_settings_menu(app) {
	if (love_ui_button("Settings", ALIGN_CENTER)) {
		love_ui_open_popup("settings");
	}
	tip(app, "Snapping, the grid, what the viewport draws, and these tips.");

	if (love_ui_begin_popup("settings")) {
		love_ui_layout_row(1, [190], 0);

		if (love_ui_checkbox("Snap to grid", app.snap, 1)) {
			app.snap = !app.snap;
			prefs_touch(app);
		}
		tip(app, "Round positions and sizes to the grid step while dragging.");

		if (love_ui_checkbox("Show grid", app.show_grid, 2)) {
			app.show_grid = !app.show_grid;
			prefs_touch(app);
		}
		tip(app, "Draw the grid. Whether it is drawn and whether Snap uses it " +
			"are separate.");

		love_ui_layout_row(2, [86, -1], 0);
		love_ui_label("grid step:");
		prefs_set_grid(app,
			love_ui_number(app.grid, 1, ID_NUM_GRID, ALIGN_CENTER, 0));
		tip(app, "In world units, " + GRID_MIN + " to " + GRID_MAX + ". Drag " +
			"it or click to type.");

		love_ui_layout_row(1, [190], 0);
		if (love_ui_checkbox("Show fixtures", app.show_fixtures, 3)) {
			app.show_fixtures = !app.show_fixtures;
			prefs_touch(app);
		}
		tip(app, "Outline every collision shape over the artwork, colour " +
			"coded by body type -- and, for a drawn mesh, the convex pieces " +
			"Box2D actually has.");

		if (love_ui_checkbox("Hover tips", app.tips, 8)) {
			app.tips = !app.tips;
			app.tip = null;
			prefs_touch(app);
		}

		if (love_ui_checkbox("Theme editor", app.show_style, 7)) {
			app.show_style = !app.show_style;
		}

		love_ui_label("");
		love_ui_label("remembered in " + PREFS_PATH);
		love_ui_end_popup();
	}

	if (love_ui_popup_open("settings")) { app.popup_open = true; }
	return 0;
}

fn panels_toolbar(app) {
	if (panels_dock(app, "Toolbar", 0, 0, app.screen_w, TOOLBAR_H)) {

		# Both rows use the same column widths for their first ten cells, so
		# the groups line up vertically: one action button is always TB_BTN
		# wide, one menu button TB_MENU, and TB_GAP separates groups. The rows
		# only diverge past the last gap, where row 2 keeps the toggles.
		#
		#   | pair            | menu          | pair          | pair          | rest
		#   | Play            | scene.json    | Save   Load   | Undo   Redo   | 3 undo
		#   | Select   Tiles  | Primitives    | Dup    Delete | Frame  Reset  | toggles
		#
		# Row 1's first group is one button and a blank, so that the tool pair
		# below it can be two: what keeps the groups lined up is the widths,
		# not how many of the cells hold something.

		# --- row 1: run, level, file, history ---
		love_ui_layout_row(12,
			[TB_BTN, TB_BTN, TB_GAP, TB_MENU, TB_GAP, TB_BTN, TB_BTN, TB_GAP,
			 TB_BTN, TB_BTN, TB_GAP, -1], 0);

		if (app.mode == "edit") {
			if (love_ui_button("Play", ALIGN_CENTER)) { sim_play(app); }
			tip(app, "Build a Box2D world from this level and run it. The " +
				"document is never written to, so Stop puts everything back.");
		} else {
			if (love_ui_button("Stop", ALIGN_CENTER)) { sim_stop(app); }
			tip(app, "Throw the simulation away and go back to the level as " +
				"you left it.");
		}
		love_ui_label("");   # under it, the Tiles tool
		love_ui_label("");

		scenes_menu(app);
		tip(app, "The level you are editing. Click to switch to another, or " +
			"for New, Save as, Rename and Delete. Every *.json beside the " +
			"game is a level.");
		love_ui_label("");

		if (ui_button_enabled("Save", app.dirty, ALIGN_CENTER)) {
			doc_save(app, app.scene_path);
		}
		tip(app, "Write the level to " + app.scene_path + ". Ctrl+S.");
		if (ui_button_enabled("Load", io_filetype(app.scene_path) == "file",
		                      ALIGN_CENTER)) {
			doc_load(app, app.scene_path);
		}
		tip(app, "Read the level back from disk, throwing away anything " +
			"unsaved.");
		love_ui_label("");

		# greyed out when there is nothing behind them; see ui_button_enabled
		if (ui_button_enabled("Undo", len(app.undo) > 0, ALIGN_CENTER)) { doc_undo(app); }
		tip(app, "Ctrl+Z. One step per gesture, up to " + UNDO_LIMIT + ".");
		if (ui_button_enabled("Redo", len(app.redo) > 0, ALIGN_CENTER)) { doc_redo(app); }
		tip(app, "Ctrl+Y. Cleared as soon as you change something else.");
		love_ui_label("");

		# the scene name and its unsaved mark live on the menu button, so this
		# is left for what the buttons beside it cannot show
		let state = "";
		if (app.mode == "play") { state = "[playing]   "; }
		love_ui_label(state + len(app.undo) + " undo");

		# --- row 2: tools, editing, view, toggles ---
		love_ui_layout_row(13,
			[TB_BTN, TB_BTN, TB_GAP, TB_MENU, TB_GAP, TB_BTN, TB_BTN, TB_GAP,
			 TB_BTN, TB_BTN, TB_GAP, TB_BTN, -1], 0);

		let select_label = "  Select";
		if (app.tool == "select") { select_label = "> Select"; }
		if (love_ui_button(select_label, ALIGN_CENTER)) {
			app.tool = "select";
			log_line(app, "tool: select");
		}
		tip(app, "Pick and move things. Shift+click adds to the selection, " +
			"dragging from empty space rubber bands over one.");

		# Pressing it while it is already the tool hides the palette rather
		# than doing nothing: the sheet covers a good part of the viewport, and
		# wanting it out of the way for a moment is not wanting another tool.
		let tile_label = "  Tiles";
		if (app.tool == "tile") { tile_label = "> Tiles"; }
		if (love_ui_button(tile_label, ALIGN_CENTER)) {
			if (app.tool == "tile") {
				app.pal_open = !app.pal_open;
			} else {
				app.tool = "tile";
				app.pal_open = true;
				log_line(app, "tool: tile -- click paints, Shift erases");
			}
		}
		tip(app, "Paint the map: pick a tile from the sheet on the right, " +
			"click to lay it down, Shift+click to rub it out. Press it again " +
			"to put the palette away.");
		love_ui_label("");

		panels_primitives_menu(app);
		tip(app, "Rect and Circle drop a shape where you click. Polygon lays " +
			"a collision mesh out point by point.");
		love_ui_label("");

		let has_selection = doc_selected(app) != null;
		if (ui_button_enabled("Duplicate", has_selection, ALIGN_CENTER)) {
			doc_duplicate(app);
		}
		tip(app, "Copy everything selected, one grid step across. Ctrl+D.");
		if (ui_button_enabled("Delete", has_selection, ALIGN_CENTER)) {
			app.confirm = true;
		}
		tip(app, "Remove everything selected, after asking. Delete or " +
			"Backspace does the same.");
		love_ui_label("");

		if (love_ui_button("Frame all", ALIGN_CENTER)) { cam_frame_all(app); }
		tip(app, "Fit the whole level in the viewport. F does it too, while " +
			"the pointer is over the scene.");
		if (love_ui_button("Reset view", ALIGN_CENTER)) { cam_reset(app); }
		tip(app, "Back to the origin at 1x.");
		love_ui_label("");

		panels_settings_menu(app);

		love_ui_end_window();
	}
	return 0;
}

fn panels_hierarchy(app) {
	if (panels_dock(app, "Hierarchy", 0, TOOLBAR_H, app.panel_l, app.hier_h)) {
		love_ui_layout_row(1, [-1], 0);
		love_ui_label("HIERARCHY");

		if (love_ui_header("Scene", OPT_EXPANDED)) {
			# negative height = "fill the rest of the panel, minus the two
			# rows below it"
			love_ui_layout_row(1, [-1], -54);
			love_ui_begin_panel(app.hierarchy_panel, "scene_list", 0);
			love_ui_layout_row(1, [-1], 0);

			let entities = doc_entities(app);
			for (let i = 0; i < len(entities); i++) {
				let e = entities[i];

				# microui derives a widget id from its label, so two
				# entities with the same name would be the same button.
				# Mixing the entity id into the id stack keeps them apart.
				love_ui_pushId(e.id);

				# ">" is the primary, the one the inspector edits; "*" is in
				# the selection but not it
				let mark = "   ";
				if (doc_is_selected(app, e.id)) { mark = "*  "; }
				if (e.id == app.selected_id) { mark = ">  "; }
				let suffix = "";
				if (!e.visible) { suffix = "   (hidden)"; }
				if (love_ui_button(mark + e.name + suffix, ALIGN_LEFT)) {
					if (love_keyboard_isDown("lshift") ||
					    love_keyboard_isDown("rshift")) {
						doc_select_toggle(app, e.id);
					} else {
						doc_select_only(app, e.id);
					}
				}

				love_ui_popId();
			}

			love_ui_end_panel();
		}

		# Z-order. The list above is the draw order, front last, so these
		# move the selection through it -- which is all z-order is here.
		let sel = doc_selected(app);
		let has = sel != null;
		let idx = -1;
		if (has) { idx = doc_index_of(app, sel.id); }
		let top = len(doc_entities(app)) - 1;

		love_ui_layout_row(4, [58, 58, 58, -1], 0);
		if (ui_button_enabled("Back", has && idx > 0, ALIGN_CENTER)) {
			doc_to_back(app, sel.id);
		}
		tip(app, "Send the selection all the way behind. This list is the " +
			"draw order, front last.");
		if (ui_button_enabled("Down", has && idx > 0, ALIGN_CENTER)) {
			doc_lower(app, sel.id);
		}
		if (ui_button_enabled("Up", has && idx < top, ALIGN_CENTER)) {
			doc_raise(app, sel.id);
		}
		if (ui_button_enabled("Front", has && idx < top, ALIGN_CENTER)) {
			doc_to_front(app, sel.id);
		}

		love_ui_layout_row(2, [-80, -1], 0);
		let counted = doc_count(app) + " entities";
		if (len(app.selection) > 1) {
			counted = len(app.selection) + " of " + doc_count(app) + " selected";
		}
		love_ui_label(counted);
		if (love_ui_button("Help", ALIGN_CENTER)) {
			love_ui_open_popup("Shortcuts");
		}

		# begun in the same window that opened it
		if (love_ui_begin_popup("Shortcuts")) {
			love_ui_layout_row(1, [330], 0);
			love_ui_text("Select tool: click to pick, drag to move. Shift+click " +
				"adds to the selection, and dragging from empty space rubber " +
				"bands over one. Moving, Duplicate and Delete take the whole " +
				"selection; the gizmo and the inspector work on one entity.");
			love_ui_text("Primitives: pick Rect or Circle, then click in the " +
				"viewport. Polygon lays down a collision mesh point by point " +
				"-- click back on the first point or press Return to close it, " +
				"Escape to throw it away. Afterwards its vertices are handles: " +
				"drag one to move it, Shift+click to remove it.");
			love_ui_text("Tiles: Inspector > Tilemap > Add sheet picks a " +
				"spritesheet and says how big one tile of it is. The Tiles " +
				"button opens the palette over the viewport: click a tile " +
				"there, then click or drag in the scene to paint it, and " +
				"Shift to rub it out. Pressing Tiles again puts the palette " +
				"away. A layer marked solid becomes static collision when " +
				"Play runs, a row of touching cells at a time.");
			love_ui_text("Brush -> selected sprite gives the entities you have " +
				"selected the brush's tile as their artwork -- the same sheet, " +
				"cropped to that one tile.");
			love_ui_text("Pan: drag with the right or middle button, space + left, " +
				"or the arrow keys while the cursor is over the viewport.");
			love_ui_text("Wheel zooms around the cursor. F frames the whole scene.");
			love_ui_text("Properties: free-form data on an entity -- a patrol " +
				"radius, a door's target level. true/false and numbers are " +
				"stored typed. A game reads them with scene.props(); groups " +
				"say what a thing is, properties say with what parameters.");
			love_ui_text("Appearance: the colour modulates -- it fills a shape " +
				"that has no artwork and tints one that does, so white means " +
				"untinted.");
			love_ui_text("Grid: the number beside the Grid box is the step in " +
				"world units -- drag it or click to type. It is what Snap " +
				"rounds to, and it is remembered in " + PREFS_PATH + ".");
			love_ui_text("Inspector numbers: drag left and right, or click to type.");
			love_ui_text("Sprite: Browse... opens a file picker over the whole " +
				"machine. Art inside the game folder is stored relative to it, " +
				"anything else absolutely; only the path is saved, never the image.");
			love_ui_text("Play builds a Box2D world; Stop throws it away and the " +
				"document is exactly as you left it.");
			love_ui_text("Levels: the button beside Play names the level you are " +
				"editing; click it to switch, or for New / Save as / Rename / " +
				"Delete. Every *.json beside the game is a level, editor.json " +
				"excepted. Switching remembers where you were looking.");
			love_ui_text("Joints: select two entities and the Joints section " +
				"offers a distance link or a revolute hinge between them. " +
				"They are drawn in the viewport and built when Play starts; " +
				"deleting an entity takes its joints with it.");
			love_ui_text("Filter: layer is what a fixture is, hits is what it " +
				"is willing to touch -- two fixtures collide only when each " +
				"one's layer is in the other's mask. A game reads it with " +
				"scene.filter_data().");
			love_ui_text("Z-order: the hierarchy list is the draw order, front " +
				"last. Back / Down / Up / Front move the selection through it.");
			love_ui_text("Links: name a reference from one entity to another " +
				"-- a door's exit, a lever's target. A game follows it with " +
				"scene.link(e, name) and gets the entity back; deleting the " +
				"target drops the link rather than leaving it dangling.");
			love_ui_text("Level: with nothing selected the inspector shows the " +
				"level itself -- gravity and the metre. Both are saved with " +
				"it, and gravity applies to a world that is already playing.");
			love_ui_text("Settings holds snapping, the grid, the fixture " +
				"overlay, these tips and the Theme editor. Everything in it " +
				"is remembered in " + PREFS_PATH + ", and the Theme editor's " +
				"Revert puts the colours back to the one the editor ships " +
				"with.");
			love_ui_text("Ctrl+Z undo, Ctrl+Y redo, Ctrl+S save, Ctrl+D " +
				"duplicate, Ctrl+N new level, Delete removes the selection. " +
				"Esc closes a dialog, or asks before quitting.");
			love_ui_end_popup();
		}
		if (love_ui_popup_open("Shortcuts")) { app.popup_open = true; }

		love_ui_end_window();
	}
	return 0;
}

# --- inspector ------------------------------------------------------

fn panels_console(app) {
	if (panels_dock(app, "Console", 0, TOOLBAR_H + app.hier_h + SPLIT_W,
	                app.panel_l,
	                app.screen_h - TOOLBAR_H - app.hier_h - SPLIT_W)) {
		love_ui_layout_row(1, [-1], 0);
		love_ui_label("CONSOLE");

		love_ui_layout_row(1, [-1], -30);
		love_ui_begin_panel(app.console_panel, "log", 0);
		love_ui_layout_row(1, [-1], 0);
		for (let i = 0; i < len(app.log); i++) { love_ui_text(app.log[i]); }
		love_ui_end_panel();

		# the Theme editor moved into Settings, with the rest of the switches
		love_ui_layout_row(2, [-80, -1], 0);
		love_ui_label("");
		if (love_ui_button("Clear", ALIGN_CENTER)) { app.log = []; }
		tip(app, "Empty the console.");

		love_ui_end_window();
	}
	return 0;
}

fn panels_statusbar(app) {
	if (panels_dock(app, "Status", app.vp_x, app.screen_h - STATUS_H,
	                app.vp_w, STATUS_H)) {
		love_ui_layout_row(6, [90, 150, 170, 110, 100, -1], 0);

		love_ui_label("mode: " + app.mode);
		love_ui_label("world: " + tointeger(app.wx) + ", " + tointeger(app.wy));

		# With the Tiles tool up, what is selected matters much less than
		# where the brush is pointing and which layer takes it.
		if (app.tool == "tile") {
			let layer = tiles_current_layer(app);
			let where = "cell: none";
			if (layer != null) {
				let c = tiles_cell_of(app, app.wx, app.wy);
				where = layer.name + " " + c[0] + "," + c[1];
			}
			love_ui_label(where);
		} else {
			let name = "none";
			let e = doc_selected(app);
			if (e != null) { name = e.name + " (#" + e.id + ")"; }
			love_ui_label("selected: " + name);
		}
		love_ui_label("zoom: " + app.cam.zoom + "x");
		love_ui_label("meter: " + app.doc_data.meter);

		# While Play runs, the last contact is more use here than the frame
		# rate: it names the two entities that touched.
		if (app.mode == "play" && len(app.contacts) > 0) {
			love_ui_label("hit: " +
				sim_contact_names(app, app.contacts[len(app.contacts) - 1]));
		} else {
			love_ui_label("fps: " + tointeger(love_timer_getFPS()));
		}

		love_ui_end_window();
	}
	return 0;
}

fn panels_style_row(app, name, id) {
	let c = love_ui_getColor(name);
	love_ui_label(name);
	let r = love_ui_slider(c[0], 0, 255, 1, id, ALIGN_CENTER);
	let g = love_ui_slider(c[1], 0, 255, 1, id + 1, ALIGN_CENTER);
	let b = love_ui_slider(c[2], 0, 255, 1, id + 2, ALIGN_CENTER);
	# c[4] is the MU_COLOR_* id love_ui_getColor() resolved the name to
	if (r != c[0] || g != c[1] || b != c[2]) { prefs_touch(app); }
	love_ui_setColor(c[4], r, g, b, c[3]);
	let sw = love_ui_layout_next();
	love_ui_rect(sw[0], sw[1], sw[2], sw[3], r, g, b, 255);
	return 0;
}

fn panels_theme(app) {
	if (!app.show_style) {
		app.style_open = false;
		return 0;
	}

	# microui latches a window shut once its own close button is used -- the
	# container's open flag goes to 0 and begin_window answers false for good.
	# Re-open it by hand on the frame the check box turns back on. This has to
	# happen out here, at the same scope the window is begun in: the name is
	# hashed against the top of the id stack, so asking from inside the console
	# panel would address a different container.
	if (!app.style_open) {
		love_ui_setWindowOpen("Theme editor", true);
		app.style_open = true;
	}
	# No panels_dock_opts(app) here on purpose: this one has a title bar you can drag
	# and a grip you can resize, which is a plain microui window.
	if (love_ui_begin_window("Theme editor", dialog_x(app, 470), dialog_y(app, 300),
	                         470, 300, 0)) {
		love_ui_layout_row(1, [-1], 0);
		love_ui_text("Live microui style colours. This window is draggable and " +
		             "resizable; the editor panels pass notitle + noresize so " +
		             "they stay docked.");

		love_ui_layout_row(5, [110, 70, 70, 70, -1], 0);
		panels_style_row(app, "windowBg", ID_STYLE_BASE);
		panels_style_row(app, "button", ID_STYLE_BASE + 3);
		panels_style_row(app, "buttonHover", ID_STYLE_BASE + 6);
		panels_style_row(app, "text", ID_STYLE_BASE + 9);
		panels_style_row(app, "border", ID_STYLE_BASE + 12);

		love_ui_layout_row(2, [-110, -1], 0);
		love_ui_label("");
		if (love_ui_button("Revert", ALIGN_CENTER)) {
			theme_apply(app, THEME_DEFAULT);
			prefs_touch(app);
			log_line(app, "theme back to the default");
		}
		tip(app, "Back to the theme the editor ships with, the one in " +
			"THEME_DEFAULT. Whatever is on screen is what gets written to " +
			PREFS_PATH + ", so this un-remembers a custom one too.");

		love_ui_end_window();
	} else {
		# microui returns 0 once its own title-bar close button has been
		# pressed, so this is where the check box in the console panel finds
		# out the window is gone
		app.show_style = false;
		app.style_open = false;
	}
	return 0;
}

fn panels_confirm(app) {
	if (!app.confirm) { return 0; }
	# A self-managed modal rather than a microui popup, because a popup can
	# only be closed by clicking outside it.
	let h = dialog_height(2);   # the question, then the buttons
	if (love_ui_begin_window("Confirm", dialog_x(app, DIALOG_W), dialog_y(app, h),
	                         DIALOG_W, h,
	                         love_ui_opt("noresize") + love_ui_opt("noclose"))) {
		love_ui_layout_row(1, [-1], 0);
		let e = doc_selected(app);
		let name = "the selection";
		if (e != null) { name = e.name; }
		love_ui_text("Delete " + name + "?");

		love_ui_layout_row(2, [-90, -1], 0);
		if (love_ui_button("Delete", ALIGN_CENTER)) {
			doc_delete_selected(app);
			app.confirm = false;
		}
		if (love_ui_button("Cancel", ALIGN_CENTER)) { app.confirm = false; }

		love_ui_end_window();
	}
	return 0;
}
