# ============================================================================
#  tiles.fh -- spritesheets, and the map painted out of them
# ----------------------------------------------------------------------------
#  A tile map is not a lot of little entities. Ten thousand crates would be
#  ten thousand entities' worth of name, transform, colour, body and fixture
#  in the file, and in every undo snapshot, for a thing whose whole content is
#  "sheet 1, the tile at column 4 row 2". So a painted cell is exactly that:
#  three numbers, in a map keyed by the cell it sits in.
#
#  The document grows two fields (doc.fh has the whole layout):
#
#    "tilesets": [ { "id": 1, "name": "terrain.png", "path": "art/terrain.png",
#                    "tile_w": 32, "tile_h": 32, "margin": 0, "spacing": 0 } ],
#    "tilemap":  { "tile_w": 32, "tile_h": 32,
#                  "layers": [ { "id": 1, "name": "Ground", "visible": true,
#                                "solid": false,
#                                "cells": { "3,-1": [1, 4, 2] } } ] }
#
#  A cell holds [tileset id, column, row] -- where the tile *is in the sheet*,
#  not an index into it. An index has to be read back through the sheet's
#  column count, which is a property of the image file rather than of the
#  level: crop the sheet, or swap it for one a tile wider, and every index in
#  every level means a different picture. A column and a row survive that.
#
#  Nothing derived from the image is stored, the same way a traced outline is
#  not: how many columns a sheet has, and the quads that cut it up, are worked
#  out from the loaded image and cached on the app.
#
#  The palette -- the sheet you pick a tile from -- is drawn in the viewport
#  with the ordinary graphics calls rather than as a panel, because microui
#  cannot draw an image at all. Everything about it that is a *setting* (which
#  sheet, the tile size, the layers) is a panel, in tiles_panel().
# ============================================================================


# The palette overlay, in screen pixels. It floats inside the viewport, against
# its right edge, rather than taking a dock of its own: the sheet is only
# wanted while something is being painted, and a fourth dock would still be
# there for the rest of the time.
let PAL_W       = 250;   # at most: it gives way to the scene in a narrow one
let PAL_MIN_W   = 120;   # and below this there is no room for it at all
let PAL_KEEP    = 150;   # of the viewport is always left for the scene
let PAL_MARGIN  = 12;
let PAL_PAD     = 8;
let PAL_HEADER  = 24;
let PAL_FOOTER  = 20;


# ============================================================================
#  The document side
# ============================================================================

fn tiles_new_layer(id, name) {
	return { "id": id, "name": name, "visible": true, "solid": false,
	         "cells": {} };
}

# A level always has one layer: painting with nowhere to paint is a state with
# no answer to "where did my tile go", and one layer is what a map is.
fn tilemap_empty() {
	return { "tile_w": TILE_DEFAULT, "tile_h": TILE_DEFAULT,
	         "layers": [ tiles_new_layer(1, "Ground") ] };
}

fn tiles_sets(app)   { return app.doc_data.tilesets; }
fn tiles_map(app)    { return app.doc_data.tilemap; }
fn tiles_layers(app) { return app.doc_data.tilemap.layers; }

# One past the highest id in a list of things that have one. Ids are only ever
# handed out here, and a deleted tileset takes its cells with it, so reusing a
# number cannot resurrect a reference to the old one.
fn tiles_next_id(list) {
	let highest = 0;
	for (let i = 0; i < len(list); i++) {
		if (list[i].id > highest) { highest = list[i].id; }
	}
	return highest + 1;
}

fn tiles_find_set(app, id) {
	let sets = tiles_sets(app);
	for (let i = 0; i < len(sets); i++) {
		if (sets[i].id == id) { return sets[i]; }
	}
	return null;
}

fn tiles_find_layer(app, id) {
	let layers = tiles_layers(app);
	for (let i = 0; i < len(layers); i++) {
		if (layers[i].id == id) { return layers[i]; }
	}
	return null;
}

# The sheet the palette is showing. app.tile_set is a session choice, not
# document data -- so it falls back to the first sheet rather than being
# something a level has to remember.
fn tiles_current_set(app) {
	let ts = tiles_find_set(app, app.tile_set);
	if (ts != null) { return ts; }
	let sets = tiles_sets(app);
	if (len(sets) == 0) { return null; }
	app.tile_set = sets[0].id;
	return sets[0];
}

fn tiles_current_layer(app) {
	let layer = tiles_find_layer(app, app.tile_layer);
	if (layer != null) { return layer; }
	let layers = tiles_layers(app);
	if (len(layers) == 0) { return null; }
	app.tile_layer = layers[0].id;
	return layers[0];
}

fn tiles_set_index(app, id) {
	let sets = tiles_sets(app);
	for (let i = 0; i < len(sets); i++) {
		if (sets[i].id == id) { return i; }
	}
	return -1;
}

# --- sheets -----------------------------------------------------------------

# `path` is stored the way a sprite's is: relative to the game directory when
# the file is inside it, absolute otherwise (browser.fh decides that).
fn tiles_add_set(app, path) {
	doc_begin_edit(app);
	let ts = { "id": tiles_next_id(tiles_sets(app)),
	           "name": path_name(path),
	           "path": path,
	           "tile_w": tiles_map(app).tile_w,
	           "tile_h": tiles_map(app).tile_h,
	           "margin": 0, "spacing": 0,
	           # what individual tiles of this sheet are, keyed the same way a
	           # cell is: "4,2" -> { "solid": true, ... }. See tile_settings().
	           "tiles": {} };
	append(tiles_sets(app), ts);
	app.tile_set = ts.id;
	app.brush = null;
	log_line(app, "sheet: " + ts.name);
	return ts;
}

# Removing a sheet takes every cell painted from it: a cell that names a sheet
# the level no longer has is a hole that draws nothing and cannot be undone
# into anything meaningful.
fn tiles_remove_set(app, id) {
	if (tiles_find_set(app, id) == null) { return 0; }
	doc_begin_edit(app);

	let kept = [];
	let sets = tiles_sets(app);
	for (let i = 0; i < len(sets); i++) {
		if (sets[i].id != id) { append(kept, sets[i]); }
	}
	app.doc_data.tilesets = kept;

	let dropped = 0;
	let layers = tiles_layers(app);
	for (let i = 0; i < len(layers); i++) {
		let cells = layers[i].cells;
		let doomed = [];
		let k = next_key(cells, null);
		while (k != null) {
			if (cells[k][0] == id) { append(doomed, k); }
			k = next_key(cells, k);
		}
		for (let d = 0; d < len(doomed); d++) {
			delete(cells, doomed[d]);
			dropped = dropped + 1;
		}
	}

	if (app.brush != null && app.brush[0] == id) { app.brush = null; }
	app.tile_set = -1;
	tiles_current_set(app);
	log_line(app, "sheet removed, " + dropped + " cells with it");
	return 0;
}

# --- layers -----------------------------------------------------------------

fn tiles_add_layer(app) {
	doc_begin_edit(app);
	let layer = tiles_new_layer(tiles_next_id(tiles_layers(app)),
		"Layer " + (len(tiles_layers(app)) + 1));
	append(tiles_layers(app), layer);
	app.tile_layer = layer.id;
	log_line(app, "layer: " + layer.name);
	return layer;
}

fn tiles_delete_layer(app, id) {
	let layers = tiles_layers(app);
	if (len(layers) <= 1) {
		log_line(app, "a map keeps one layer");
		return 0;
	}
	doc_begin_edit(app);

	let kept = [];
	for (let i = 0; i < len(layers); i++) {
		if (layers[i].id != id) { append(kept, layers[i]); }
	}
	app.doc_data.tilemap.layers = kept;
	app.tile_layer = kept[len(kept) - 1].id;
	log_line(app, "layer deleted");
	return 0;
}

fn tiles_clear_layer(app, layer) {
	if (layer == null || len(layer.cells) == 0) { return 0; }
	doc_begin_edit(app);
	let n = len(layer.cells);
	layer.cells = {};
	log_line(app, "cleared " + n + " cells");
	return 0;
}

# Array order is draw order, back first -- the same rule the hierarchy's
# z-order buttons follow for entities.
fn tiles_move_layer(app, id, delta) {
	let layers = tiles_layers(app);
	let from = -1;
	for (let i = 0; i < len(layers); i++) {
		if (layers[i].id == id) { from = i; }
	}
	if (from < 0) { return 0; }

	let to = from + delta;
	if (to < 0 || to >= len(layers)) { return 0; }

	doc_begin_edit(app);
	let moved = layers[from];
	layers[from] = layers[to];
	layers[to] = moved;
	return 0;
}

# --- cells ------------------------------------------------------------------
#
# The key is the cell's coordinate as text, because a map key is a string and
# a cell is two numbers. It is parsed back the same way, so anything that
# writes one has to go through tile_key().

fn tile_key(cx, cy) { return "" + cx + "," + cy; }

fn tile_key_cell(key) {
	let parts = string_split(key, ",");
	if (len(parts) != 2) { return null; }
	return [tonumber(parts[0]), tonumber(parts[1])];
}

fn tiles_get(layer, cx, cy) {
	if (layer == null) { return null; }
	let key = tile_key(cx, cy);
	if (!contains_key(layer.cells, key)) { return null; }
	return layer.cells[key];
}

# An edit step is only opened when the cell actually changes: dragging the
# brush back and forth over one tile is one paint, not forty undo steps.
fn tiles_put(app, layer, cx, cy, cell) {
	if (layer == null) { return false; }
	let old = tiles_get(layer, cx, cy);
	if (old != null && old[0] == cell[0] && old[1] == cell[1] && old[2] == cell[2]) {
		return false;
	}
	doc_begin_edit(app);
	layer.cells[tile_key(cx, cy)] = [cell[0], cell[1], cell[2]];
	return true;
}

fn tiles_erase(app, layer, cx, cy) {
	if (layer == null) { return false; }
	let key = tile_key(cx, cy);
	if (!contains_key(layer.cells, key)) { return false; }
	doc_begin_edit(app);
	delete(layer.cells, key);
	return true;
}

# World point -> the cell that covers it. math_floor, not a cast: a point at
# x = -1 is in cell -1, and truncation would put it in cell 0 along with
# everything from 0 to 31.
fn tiles_cell_of(app, wx, wy) {
	let m = tiles_map(app);
	return [math_floor(wx / m.tile_w), math_floor(wy / m.tile_h)];
}

fn tiles_cell_rect(app, cx, cy) {
	let m = tiles_map(app);
	return [cx * m.tile_w, cy * m.tile_h, m.tile_w, m.tile_h];
}

fn tiles_count(app) {
	let n = 0;
	let layers = tiles_layers(app);
	for (let i = 0; i < len(layers); i++) { n = n + len(layers[i].cells); }
	return n;
}

# [min_x, min_y, max_x, max_y] over every painted cell, or null when the map is
# empty. Frame all reads it, so a level that is only tiles still frames.
fn tiles_bounds(app) {
	let m = tiles_map(app);
	let layers = tiles_layers(app);
	let found = false;
	let minx = 0;
	let miny = 0;
	let maxx = 0;
	let maxy = 0;

	for (let i = 0; i < len(layers); i++) {
		let cells = layers[i].cells;
		let k = next_key(cells, null);
		while (k != null) {
			let c = tile_key_cell(k);
			if (c != null) {
				let x0 = c[0] * m.tile_w;
				let y0 = c[1] * m.tile_h;
				if (!found) {
					found = true;
					minx = x0;
					miny = y0;
					maxx = x0 + m.tile_w;
					maxy = y0 + m.tile_h;
				} else {
					if (x0 < minx) { minx = x0; }
					if (y0 < miny) { miny = y0; }
					if (x0 + m.tile_w > maxx) { maxx = x0 + m.tile_w; }
					if (y0 + m.tile_h > maxy) { maxy = y0 + m.tile_h; }
				}
			}
			k = next_key(cells, k);
		}
	}

	if (!found) { return null; }
	return [minx, miny, maxx, maxy];
}


# ============================================================================
#  The sheet: slicing an image into tiles
# ============================================================================

fn tileset_image(app, ts) {
	if (ts == null) { return null; }
	return sprite_image(app, ts.path);
}

fn tileset_columns(app, ts) {
	let img = tileset_image(app, ts);
	if (img == null) { return 0; }
	let usable = love_image_getWidth(img) - ts.margin * 2 + ts.spacing;
	let step = ts.tile_w + ts.spacing;
	if (step <= 0 || usable <= 0) { return 0; }
	return math_floor(usable / step);
}

fn tileset_rows(app, ts) {
	let img = tileset_image(app, ts);
	if (img == null) { return 0; }
	let usable = love_image_getHeight(img) - ts.margin * 2 + ts.spacing;
	let step = ts.tile_h + ts.spacing;
	if (step <= 0 || usable <= 0) { return 0; }
	return math_floor(usable / step);
}

# Where a tile sits in the sheet, in pixels: [x, y, w, h]. Pure arithmetic, no
# image needed -- the scene package computes the same rect from the same four
# numbers, which is what lets a game read a level without this file.
fn tileset_src(ts, tx, ty) {
	return [ts.margin + tx * (ts.tile_w + ts.spacing),
	        ts.margin + ty * (ts.tile_h + ts.spacing),
	        ts.tile_w, ts.tile_h];
}

# --- which tiles collide ----------------------------------------------------
#
#  A cell collides when the *layer* it is in is marked solid, or when the tile
#  it holds is. The two answer different questions and a level wants both: a
#  ground layer is solid whatever is painted in it, while a stone block is
#  solid wherever it lands -- including in a layer full of grass that is not.
#
#  The flag is on the sheet rather than on each cell, because it is a property
#  of the picture: stone is stone in every level it is painted into, and
#  saying so once beats saying it in ten thousand cells. It is keyed by the
#  tile's column and row, in the same "x,y" text a cell coordinate uses.
#
#  What a tile cannot be is *dynamic*. A cell has no body of its own -- the
#  solid ones are merged into static shapes on Play -- so a crate that is
#  meant to be pushed around is an entity, not a tile. tiles_entity_from_brush()
#  is the short way there: it makes one out of the tile you have picked.

# What one tile of a sheet is: solid or not, and if it is, what it collides
# as. Absent for the great majority of tiles -- only the ones someone has said
# something about are in the map at all.
fn tile_settings_new() {
	return { "solid": true,
	         "friction": TILE_FRICTION,
	         "restitution": TILE_RESTITUTION,
	         "sensor": false,
	         # Box2D's filter, the same two bit fields an entity's fixture has
	         "category": 1, "mask": 65535, "group": 0,
	         # What a contact callback is handed for this tile. A merged run
	         # has no entity behind it, so without this a game can tell that it
	         # hit the map and nothing else -- with it, it can tell ice from
	         # lava. Empty means "nothing in particular".
	         "name": "" };
}

# Optional chaining, `?.["key"]`, is the same lookup as `["key"]` but answers
# null instead of erroring when what it is indexing is null or has no such key
# -- which is exactly the three guards this used to spell out.
fn tile_settings(ts, tx, ty) {
	return ts?.["tiles"]?.[tile_key(tx, ty)];
}

fn tileset_is_solid(ts, tx, ty) {
	let t = tile_settings(ts, tx, ty);
	return t != null && t.solid;
}

# Marking a tile solid gives it a settings entry; unmarking takes the entry
# away rather than leaving a `false` behind, so a sheet nobody has said
# anything about stays empty in the file.
fn tiles_toggle_tile_solid(app, ts, tx, ty) {
	if (ts == null) { return 0; }
	if (!contains_key(ts, "tiles")) { ts.tiles = {}; }

	doc_begin_edit(app);
	let key = tile_key(tx, ty);
	if (contains_key(ts.tiles, key)) {
		delete(ts.tiles, key);
		log_line(app, ts.name + " " + key + ": no longer solid");
	} else {
		ts.tiles[key] = tile_settings_new();
		log_line(app, ts.name + " " + key + ": solid");
	}
	return 0;
}

fn tiles_cell_is_solid(app, layer, cell) {
	if (layer.solid) { return true; }
	return tileset_is_solid(tiles_find_set(app, cell[0]), cell[1], cell[2]);
}

# What a cell collides as: the tile's own settings when it has them, and the
# defaults when it is solid only because its layer is.
fn tiles_cell_physics(app, layer, cell) {
	let t = tile_settings(tiles_find_set(app, cell[0]), cell[1], cell[2]);
	if (t != null) { return t; }
	return tile_settings_new();
}


# Quads are cached because a screenful of tiles asks for the same few hundred
# of them every frame, and love_graphics_newQuad() allocates. The key carries
# everything the quad is made of, so changing a sheet's tile size or margin
# simply stops hitting the old entries instead of needing them invalidated.
fn tile_quad(app, img, path, rect) {
	let key = path + "|" + rect[0] + "," + rect[1] + "," + rect[2] + "," + rect[3];
	if (contains_key(app.quad_cache, key)) { return app.quad_cache[key]; }

	let q = love_graphics_newQuad(rect[0], rect[1], rect[2], rect[3],
		love_image_getWidth(img), love_image_getHeight(img));
	app.quad_cache[key] = q;
	return q;
}

fn tileset_quad(app, ts, tx, ty) {
	let img = tileset_image(app, ts);
	if (img == null) { return null; }
	return tile_quad(app, img, ts.path, tileset_src(ts, tx, ty));
}


# ============================================================================
#  Painting
# ============================================================================

# --- the brush --------------------------------------------------------------
#
#  A brush is [sheet id, column, row] and, when a block of the sheet was
#  dragged out rather than one tile clicked, how many tiles across and down it
#  covers. The two extra numbers are optional so that everything which only
#  ever wanted one tile still reads the first three and is right.

# v modulo n, for the floats a cell coordinate is made of, and right for a
# negative v -- cell -1 of a two-tile block is its second tile, not its first.
fn tile_wrap(v, n) {
	if (n <= 0) { return 0; }
	return math_floor(v - math_floor(v / n) * n + 0.5);
}

fn brush_cols(brush) {
	if (brush == null || len(brush) < 5) { return 1; }
	return brush[3];
}

fn brush_rows(brush) {
	if (brush == null || len(brush) < 5) { return 1; }
	return brush[4];
}

# Is this cell inside the block a real tile of the sheet? A block dragged to
# the edge of a sheet can cover columns that are not there.
fn brush_tile_exists(app, brush, dx, dy) {
	let ts = tiles_find_set(app, brush[0]);
	if (ts == null) { return false; }
	return brush[1] + dx < tileset_columns(app, ts) &&
	       brush[2] + dy < tileset_rows(app, ts);
}

# One stamp of the brush, with its top-left corner in the cell given. A single
# tile is the ordinary case and comes out of the same loop.
fn tiles_stamp(app, layer, cx, cy, erase) {
	let cols = 1;
	let rows = 1;
	if (!erase) {
		if (app.brush == null) { return 0; }
		cols = brush_cols(app.brush);
		rows = brush_rows(app.brush);
	} else if (app.brush != null) {
		# erasing with a block brush takes the block, so the two are undone
		# by the same gesture that laid them down
		cols = brush_cols(app.brush);
		rows = brush_rows(app.brush);
	}

	for (let dy = 0; dy < rows; dy++) {
		for (let dx = 0; dx < cols; dx++) {
			if (erase) {
				tiles_erase(app, layer, cx + dx, cy + dy);
			} else if (brush_tile_exists(app, app.brush, dx, dy)) {
				tiles_put(app, layer, cx + dx, cy + dy,
					[app.brush[0], app.brush[1] + dx, app.brush[2] + dy]);
			}
		}
	}
	return 0;
}

# A hidden layer is not painted into: a stroke that lands somewhere invisible
# is worse than one that does nothing. Silently, because this runs per cell of
# a drag -- the cursor is what says so, in cursor_update().
fn tiles_paint(app, wx, wy, erase) {
	let layer = tiles_current_layer(app);
	if (layer == null || !layer.visible) { return 0; }

	let c = tiles_cell_of(app, wx, wy);
	return tiles_stamp(app, layer, c[0], c[1], erase);
}

# Whether a click erases: the switch in the panel, flipped by Shift. Holding a
# key is the quick way for one cell; the switch is for a hundred.
fn tiles_erasing(app, shift) {
	return app.tile_erase != shift;
}


# --- filling ----------------------------------------------------------------

# Every cell of a rectangle, given the two corners a drag ran between. The
# brush is tiled across it rather than repeated, so a block of four different
# tiles fills a wall with the pattern it is, not with sixteen copies of its
# first tile.
fn tiles_fill_rect(app, from_cell, to_cell, erase) {
	let layer = tiles_current_layer(app);
	if (layer == null || !layer.visible) { return 0; }

	let x0 = math_min(from_cell[0], to_cell[0]);
	let x1 = math_max(from_cell[0], to_cell[0]);
	let y0 = math_min(from_cell[1], to_cell[1]);
	let y1 = math_max(from_cell[1], to_cell[1]);

	let cols = brush_cols(app.brush);
	let rows = brush_rows(app.brush);

	for (let cy = y0; cy <= y1; cy++) {
		for (let cx = x0; cx <= x1; cx++) {
			if (erase) {
				tiles_erase(app, layer, cx, cy);
				continue;
			}
			if (app.brush == null) { continue; }

			# which tile of the block this cell falls on, counted from the
			# rectangle's corner so the pattern lines up with the rectangle.
			# Not `%`: a cell coordinate comes out of math_floor() as a float
			# and FH's modulo is for integers.
			let dx = tile_wrap(cx - x0, cols);
			let dy = tile_wrap(cy - y0, rows);
			if (brush_tile_exists(app, app.brush, dx, dy)) {
				tiles_put(app, layer, cx, cy,
					[app.brush[0], app.brush[1] + dx, app.brush[2] + dy]);
			}
		}
	}
	return 0;
}

# The run of identical tiles a cell belongs to, four-connected. It only ever
# walks cells that *hold* something: flooding empty space has no edge to stop
# at, and a map is unbounded -- filling the sky would be filling forever. To
# lay tiles into empty space, drag a rectangle.
let FILL_LIMIT = 20000;

fn tiles_fill_from(app, wx, wy, erase) {
	let layer = tiles_current_layer(app);
	if (layer == null || !layer.visible) { return 0; }

	let at = tiles_cell_of(app, wx, wy);
	let target = tiles_get(layer, at[0], at[1]);
	if (target == null) {
		log_line(app, "fill needs a tile to start from -- drag a rectangle instead");
		return 0;
	}

	# the frontier, as flat pairs; `seen` keeps a cell from being queued twice
	let stack = [at[0], at[1]];
	let seen = { };
	seen[tile_key(at[0], at[1])] = true;
	let filled = 0;

	while (len(stack) >= 2 && filled < FILL_LIMIT) {
		let cy = stack[len(stack) - 1];
		let cx = stack[len(stack) - 2];
		stack = drop_last(drop_last(stack));

		let here = tiles_get(layer, cx, cy);
		if (here == null) { continue; }
		if (here[0] != target[0] || here[1] != target[1] || here[2] != target[2]) {
			continue;
		}

		if (erase) {
			tiles_erase(app, layer, cx, cy);
		} else if (app.brush != null) {
			tiles_put(app, layer, cx, cy,
				[app.brush[0], app.brush[1], app.brush[2]]);
		}
		filled = filled + 1;

		let around = [cx + 1, cy, cx - 1, cy, cx, cy + 1, cx, cy - 1];
		for (let i = 0; i + 1 < len(around); i = i + 2) {
			let key = tile_key(around[i], around[i + 1]);
			if (!contains_key(seen, key)) {
				seen[key] = true;
				append(stack, around[i]);
				append(stack, around[i + 1]);
			}
		}
	}

	log_line(app, "filled " + filled + " cells");
	return 0;
}

# Fills the cells the current brush covers along a line, so a fast drag does
# not leave gaps: the mouse only reports where it is once a frame, and a cell
# is easily crossed between two of them.
fn tiles_paint_line(app, from_x, from_y, to_x, to_y, erase) {
	let a = tiles_cell_of(app, from_x, from_y);
	let b = tiles_cell_of(app, to_x, to_y);
	let steps = math_max(math_abs(b[0] - a[0]), math_abs(b[1] - a[1]));
	if (steps == 0) { return tiles_paint(app, to_x, to_y, erase); }

	let m = tiles_map(app);
	for (let i = 0; i <= steps; i++) {
		let t = i * 1.0 / steps;
		# the middle of the cell, so rounding cannot land it one over
		let cx = a[0] + (b[0] - a[0]) * t;
		let cy = a[1] + (b[1] - a[1]) * t;
		tiles_paint(app, (math_floor(cx + 0.5) + 0.5) * m.tile_w,
		                 (math_floor(cy + 0.5) + 0.5) * m.tile_h, erase);
	}
	return 0;
}


# ============================================================================
#  Collision
# ============================================================================
#
#  A layer marked solid becomes static bodies when Play runs. One body per
#  tile would be thousands of them, and Box2D would spend its time on contacts
#  between neighbours that can never move -- so a row of touching cells becomes
#  one rectangle. That also removes the seams a body-per-tile floor has, where
#  a moving box catches on the edge between two tiles.

fn tiles_row_runs(cols) {
	# insertion sort: a row holds tens of entries, and this keeps the merge
	# below to a single pass
	for (let i = 1; i < len(cols); i++) {
		let v = cols[i];
		let k = i - 1;
		while (k >= 0 && cols[k] > v) {
			cols[k + 1] = cols[k];
			k = k - 1;
		}
		cols[k + 1] = v;
	}

	let runs = [];
	let start = 0;
	let prev = 0;
	let open = false;
	for (let i = 0; i < len(cols); i++) {
		if (!open) {
			start = cols[i];
			prev = cols[i];
			open = true;
		} else if (cols[i] == prev + 1) {
			prev = cols[i];
		} else if (cols[i] != prev) {
			append(runs, [start, prev]);
			start = cols[i];
			prev = cols[i];
		}
	}
	if (open) { append(runs, [start, prev]); }
	return runs;
}

# What a run of cells collides as, as one string: two neighbours merge only
# when every one of these matches, or the merge would quietly give a patch of
# ice the friction of the stone beside it.
fn tiles_physics_key(t) {
	return "" + t.friction + "|" + t.restitution + "|" + t.sensor + "|" +
		t.category + "|" + t.mask + "|" + t.group + "|" + t.name;
}

# One entry per merged run: where it is, and what it collides as.
#
#   { "x": 0, "y": 320, "w": 160, "h": 32,
#     "friction": 0.4, "restitution": 0, "sensor": false,
#     "category": 1, "mask": 65535, "group": 0, "name": "" }
#
# Rows are merged, columns are not: a column of cells is a different shape from
# a row of them only in how many rectangles it takes, and one pass is enough to
# turn a floor into a handful of shapes. What it must not do is merge across
# different physics, which is what the key above is for.
fn tiles_solid_runs(app) {
	let m = tiles_map(app);
	let out = [];
	let layers = tiles_layers(app);

	for (let i = 0; i < len(layers); i++) {
		let layer = layers[i];

		# gather the cells that collide, grouped by row *and* by what they
		# collide as -- the cells map has no order of its own
		let groups = {};
		let k = next_key(layer.cells, null);
		while (k != null) {
			let c = tile_key_cell(k);
			if (c != null && tiles_cell_is_solid(app, layer, layer.cells[k])) {
				let phys = tiles_cell_physics(app, layer, layer.cells[k]);
				let key = c[1] + "|" + tiles_physics_key(phys);
				if (!contains_key(groups, key)) {
					groups[key] = { "row": c[1], "phys": phys, "cols": [] };
				}
				append(groups[key].cols, c[0]);
			}
			k = next_key(layer.cells, k);
		}

		let g = next_key(groups, null);
		while (g != null) {
			let group = groups[g];
			let runs = tiles_row_runs(group.cols);
			for (let r = 0; r < len(runs); r++) {
				let phys = group.phys;
				append(out, { "x": runs[r][0] * m.tile_w,
				              "y": group.row * m.tile_h,
				              "w": (runs[r][1] - runs[r][0] + 1) * m.tile_w,
				              "h": m.tile_h,
				              "friction": phys.friction,
				              "restitution": phys.restitution,
				              "sensor": phys.sensor,
				              "category": phys.category,
				              "mask": phys.mask,
				              "group": phys.group,
				              "name": phys.name });
			}
			g = next_key(groups, g);
		}
	}
	return out;
}


# ============================================================================
#  Drawing the map
# ============================================================================
#
#  Called inside the camera transform, and only for the cells the viewport can
#  actually see: a map is unbounded, so walking its cells would be walking
#  everything ever painted, every frame.

fn tiles_draw_cell(app, m, cx, cy, cell) {
	let ts = tiles_find_set(app, cell[0]);
	let img = tileset_image(app, ts);
	if (img == null) { return 0; }

	# the sheet's tile size need not be the map's: scale onto the cell rather
	# than leaving a gap or an overlap
	love_graphics_draw(img, tileset_quad(app, ts, cell[1], cell[2]),
		cx * m.tile_w, cy * m.tile_h, 0,
		m.tile_w * 1.0 / ts.tile_w, m.tile_h * 1.0 / ts.tile_h);
	return 0;
}

# --- batching ---------------------------------------------------------------
#
#  A screenful of cells is a screenful of draw calls, and a map is mostly the
#  same picture frame after frame. So each (layer, sheet) pair is built into a
#  sprite batch once and drawn as one call afterwards, and the batches are
#  thrown away when the document moves -- app.revision is the "this is stale
#  now" that doc_touch() already maintains.
#
#  Not while a stroke is being painted, though: the revision moves on every
#  cell then, and rebuilding a ten-thousand-cell batch per painted cell would
#  cost far more than the draw calls it saves. During a gesture the cells the
#  viewport covers are drawn one at a time -- there are only ever a screenful
#  of those -- and the batch is rebuilt once when the mouse comes up.

fn tiles_batch_for(app, layer, ts) {
	let key = layer.id + ":" + ts.id;
	if (contains_key(app.tile_batches, key)) { return app.tile_batches[key]; }

	let img = tileset_image(app, ts);
	if (img == null) { return null; }

	# how many cells this pair actually holds -- a batch cannot grow past the
	# size it was made with, and love_graphics_batch_add() refuses past it
	let cells = [];
	let k = next_key(layer.cells, null);
	while (k != null) {
		if (layer.cells[k][0] == ts.id) {
			let c = tile_key_cell(k);
			if (c != null) { append(cells, [c[0], c[1], layer.cells[k]]); }
		}
		k = next_key(layer.cells, k);
	}
	if (len(cells) == 0) {
		app.tile_batches[key] = false;    # nothing here, and remember that
		return null;
	}

	let m = tiles_map(app);
	let batch = love_graphics_newSpriteBatch(img, len(cells));
	for (let i = 0; i < len(cells); i++) {
		let cell = cells[i][2];
		love_graphics_batch_add(batch, tileset_quad(app, ts, cell[1], cell[2]),
			cells[i][0] * m.tile_w, cells[i][1] * m.tile_h, 0,
			m.tile_w * 1.0 / ts.tile_w, m.tile_h * 1.0 / ts.tile_h);
	}

	app.tile_batches[key] = batch;
	return batch;
}

fn tiles_draw_layer_batched(app, layer) {
	let sets = tiles_sets(app);
	for (let i = 0; i < len(sets); i++) {
		let batch = tiles_batch_for(app, layer, sets[i]);
		if (batch != null && batch != false) {
			love_graphics_draw(batch, 0, 0);
		}
	}
	return 0;
}

fn tiles_draw_layer_cells(app, layer, m, cx0, cy0, cx1, cy1) {
	# Two ways round the same picture, and the cheaper one wins: walk the
	# cells the viewport covers, or walk what the layer holds. Zoomed in on a
	# big map the first is a few hundred lookups; zoomed out over a nearly
	# empty one it is tens of thousands of misses, and the layer itself is
	# shorter than that.
	let span = (cx1 - cx0 + 1) * (cy1 - cy0 + 1);

	if (len(layer.cells) < span) {
		let k = next_key(layer.cells, null);
		while (k != null) {
			let c = tile_key_cell(k);
			if (c != null && c[0] >= cx0 && c[0] <= cx1 &&
			    c[1] >= cy0 && c[1] <= cy1) {
				tiles_draw_cell(app, m, c[0], c[1], layer.cells[k]);
			}
			k = next_key(layer.cells, k);
		}
		return 0;
	}

	for (let cy = cy0; cy <= cy1; cy++) {
		for (let cx = cx0; cx <= cx1; cx++) {
			let cell = tiles_get(layer, cx, cy);
			if (cell != null) { tiles_draw_cell(app, m, cx, cy, cell); }
		}
	}
	return 0;
}

fn tiles_draw_layers(app) {
	let m = tiles_map(app);
	let layers = tiles_layers(app);
	if (len(layers) == 0) { return 0; }

	# a gesture in progress moves the revision on every cell, so the batches
	# wait for it to finish rather than being rebuilt inside it
	let settled = app.paint == null && app.tile_rect == null;
	if (app.tile_batch_rev != app.revision) {
		if (settled) {
			app.tile_batches = {};
			app.tile_batch_rev = app.revision;
		}
	}
	let batched = settled && app.tile_batch_rev == app.revision;

	let tl = cam_to_world(app, app.vp_x, app.vp_y);
	let br = cam_to_world(app, app.vp_x + app.vp_w, app.vp_y + app.vp_h);
	let cx0 = math_floor(tl[0] / m.tile_w);
	let cy0 = math_floor(tl[1] / m.tile_h);
	let cx1 = math_floor(br[0] / m.tile_w);
	let cy1 = math_floor(br[1] / m.tile_h);

	love_graphics_setColor(255, 255, 255, 255);

	for (let i = 0; i < len(layers); i++) {
		let layer = layers[i];
		if (!layer.visible || len(layer.cells) == 0) { continue; }

		if (batched) {
			tiles_draw_layer_batched(app, layer);
		} else {
			tiles_draw_layer_cells(app, layer, m, cx0, cy0, cx1, cy1);
		}
	}
	return 0;
}


# What Play would collide with, drawn over the map when the fixture overlay is
# on -- the same question the fixture outlines answer for entities, and the
# only way to see that a tile marked solid actually made it into a run.
#
# The merge walks every painted cell, so what it found is kept until the
# document moves: app.revision is exactly the "this is stale now" that
# doc_touch() maintains.
fn tiles_solid_cache(app) {
	if (app.solid_rev != app.revision) {
		app.solid_runs = tiles_solid_runs(app);
		app.solid_rev = app.revision;
	}
	return app.solid_runs;
}

fn tiles_draw_solid(app) {
	if (!app.show_fixtures) { return 0; }

	let runs = tiles_solid_cache(app);
	for (let i = 0; i < len(runs); i++) {
		let r = runs[i];
		# a sensor reports the touch and lets it through, so it is not the
		# same thing as a wall and does not look like one
		if (r.sensor) {
			love_graphics_setColor(120, 210, 190, 150);
		} else {
			love_graphics_setColor(150, 155, 165, 130);
		}
		love_geometry_rectangle("line", r.x, r.y, r.w, r.h);
	}
	love_graphics_setColor(255, 255, 255, 255);
	return 0;
}

# The cell the next click would paint, and what it would put there. Drawn
# inside the camera transform, over the map and under the panels.
fn tiles_draw_brush(app) {
	if (app.tool != "tile" || app.mode == "play") { return 0; }
	if (!app.hover_viewport) { return 0; }
	if (tiles_palette_hover(app)) { return 0; }

	let m = tiles_map(app);
	let c = tiles_cell_of(app, app.wx, app.wy);
	let erase = tiles_erasing(app,
		love_keyboard_isDown("lshift") || love_keyboard_isDown("rshift"));

	# A rectangle being dragged out is what the release will fill, so it is
	# the preview: the cell under the cursor says nothing about it.
	if (app.tile_rect != null) {
		let from = app.tile_rect;
		let x0 = math_min(from[0], c[0]);
		let y0 = math_min(from[1], c[1]);
		let w = (math_abs(c[0] - from[0]) + 1) * m.tile_w;
		let h = (math_abs(c[1] - from[1]) + 1) * m.tile_h;

		if (erase) {
			love_graphics_setColor(255, 120, 120, 60);
		} else {
			love_graphics_setColor(120, 220, 255, 60);
		}
		love_geometry_rectangle("fill", x0 * m.tile_w, y0 * m.tile_h, w, h);
		if (erase) {
			love_graphics_setColor(255, 120, 120, 230);
		} else {
			love_graphics_setColor(120, 220, 255, 230);
		}
		love_geometry_rectangle("line", x0 * m.tile_w, y0 * m.tile_h, w, h);
		love_graphics_setColor(255, 255, 255, 255);
		return 0;
	}

	let cols = brush_cols(app.brush);
	let rows = brush_rows(app.brush);
	if (app.tile_mode == "fill") {
		# fill replaces a run of identical tiles with one tile, whatever the
		# block is, so the outline is one cell
		cols = 1;
		rows = 1;
	}

	let r = [c[0] * m.tile_w, c[1] * m.tile_h, cols * m.tile_w, rows * m.tile_h];

	if (!erase && app.brush != null) {
		let ts = tiles_find_set(app, app.brush[0]);
		let img = tileset_image(app, ts);
		if (img != null) {
			# a ghost of what a click would leave, so the choice is visible
			# where it lands rather than only on the sheet
			love_graphics_setColor(255, 255, 255, 130);
			for (let dy = 0; dy < rows; dy++) {
				for (let dx = 0; dx < cols; dx++) {
					if (!brush_tile_exists(app, app.brush, dx, dy)) { continue; }
					love_graphics_draw(img,
						tileset_quad(app, ts, app.brush[1] + dx, app.brush[2] + dy),
						r[0] + dx * m.tile_w, r[1] + dy * m.tile_h, 0,
						m.tile_w * 1.0 / ts.tile_w, m.tile_h * 1.0 / ts.tile_h);
				}
			}
		}
	}

	if (erase) {
		love_graphics_setColor(255, 120, 120, 230);
	} else {
		love_graphics_setColor(120, 220, 255, 230);
	}
	love_geometry_rectangle("line", r[0], r[1], r[2], r[3]);
	love_graphics_setColor(255, 255, 255, 255);
	return 0;
}


# ============================================================================
#  The palette
# ============================================================================
#
#  Drawn with the graphics calls rather than as a microui panel, because
#  microui has no way to draw an image -- which is the entire content of a
#  palette. It follows that the clicks are hit-tested here too, and that
#  viewport_input() has to offer it the press before the scene sees it.

# How wide it may be here: it narrows with the viewport rather than covering
# it, and gives up entirely when there is nothing left to narrow into. A game's
# window is not going to be 1280 wide because the palette would like it to be.
fn tiles_palette_width(app) {
	return math_min(PAL_W, app.vp_w - PAL_KEEP - PAL_MARGIN * 2);
}

fn tiles_palette_open(app) {
	return app.tool == "tile" && app.pal_open && app.mode != "play" &&
		tiles_palette_width(app) >= PAL_MIN_W;
}

# [x, y, w, h] on screen, or null when it is not up.
fn tiles_palette_rect(app) {
	if (!tiles_palette_open(app)) { return null; }
	let w = tiles_palette_width(app);
	let x = app.vp_x + app.vp_w - w - PAL_MARGIN;
	let y = app.vp_y + PAL_MARGIN;
	let h = app.vp_h - PAL_MARGIN * 2;
	return [x, y, w, h];
}

# The scrolling area the sheet is drawn into.
fn tiles_palette_sheet_rect(app) {
	let r = tiles_palette_rect(app);
	if (r == null) { return null; }
	return [r[0] + PAL_PAD, r[1] + PAL_HEADER,
	        r[2] - PAL_PAD * 2, r[3] - PAL_HEADER - PAL_FOOTER];
}

# The sheet is fitted to the palette's width, so the tiles are as big as the
# space allows and only the scroll is left to think about.
fn tiles_palette_scale(app, ts) {
	let img = tileset_image(app, ts);
	let area = tiles_palette_sheet_rect(app);
	if (img == null || area == null) { return 1; }
	let w = love_image_getWidth(img);
	if (w <= 0) { return 1; }
	return area[2] * 1.0 / w;
}

fn tiles_palette_hover(app) {
	let r = tiles_palette_rect(app);
	if (r == null) { return false; }
	return point_in(app.mx, app.my, r[0], r[1], r[2], r[3]);
}

# Which tile a point in the palette is over, as [column, row], or null when it
# is over the gap between two of them or past the end of the sheet.
fn tiles_palette_cell_at(app, ts, sx, sy) {
	let area = tiles_palette_sheet_rect(app);
	if (area == null || ts == null) { return null; }
	if (!point_in(sx, sy, area[0], area[1], area[2], area[3])) { return null; }

	let scale = tiles_palette_scale(app, ts);
	if (scale <= 0) { return null; }

	# back to sheet pixels
	let ix = (sx - area[0]) / scale;
	let iy = (sy - area[1] + app.pal_scroll) / scale;

	let step_x = ts.tile_w + ts.spacing;
	let step_y = ts.tile_h + ts.spacing;
	if (step_x <= 0 || step_y <= 0) { return null; }

	let tx = math_floor((ix - ts.margin) / step_x);
	let ty = math_floor((iy - ts.margin) / step_y);
	if (tx < 0 || ty < 0) { return null; }
	if (tx >= tileset_columns(app, ts) || ty >= tileset_rows(app, ts)) { return null; }

	# inside the tile, not in the spacing after it
	if ((ix - ts.margin) - tx * step_x > ts.tile_w) { return null; }
	if ((iy - ts.margin) - ty * step_y > ts.tile_h) { return null; }
	return [tx, ty];
}

# How far the sheet can be scrolled: its drawn height less the area's, never
# below zero, so a sheet that fits does not move at all.
fn tiles_palette_max_scroll(app, ts) {
	let img = tileset_image(app, ts);
	let area = tiles_palette_sheet_rect(app);
	if (img == null || area == null) { return 0; }
	let drawn = love_image_getHeight(img) * tiles_palette_scale(app, ts);
	return math_max(0, drawn - area[3]);
}

fn tiles_palette_scroll_by(app, dy) {
	let ts = tiles_current_set(app);
	app.pal_scroll = app.pal_scroll + dy;
	let most = tiles_palette_max_scroll(app, ts);
	if (app.pal_scroll > most) { app.pal_scroll = most; }
	if (app.pal_scroll < 0) { app.pal_scroll = 0; }
	return 0;
}

fn tiles_pick_set(app, delta) {
	let sets = tiles_sets(app);
	if (len(sets) == 0) { return 0; }
	let i = tiles_set_index(app, app.tile_set);
	if (i < 0) { i = 0; }
	i = (i + delta + len(sets)) % len(sets);
	app.tile_set = sets[i].id;
	app.pal_scroll = 0;
	return 0;
}

# The two arrows in the header, when there is more than one sheet to cycle.
fn tiles_palette_arrows(app) {
	let r = tiles_palette_rect(app);
	if (r == null || len(tiles_sets(app)) < 2) { return null; }
	let size = 16;
	let y = r[1] + 4;
	return [[r[0] + r[2] - size * 2 - 10, y, size, size],
	        [r[0] + r[2] - size - 6, y, size, size]];
}

# Answers true when the palette took the press, so the viewport leaves it
# alone -- a click on the sheet must not also paint the scene behind it.
#
# `shift` is read from the press rather than from what is held now, for the
# same reason the scene's is: a frame later it may already be up.
# A block dragged out on the sheet becomes the brush: from the tile the press
# landed on to the one under the cursor when it came up. A click is that with
# both ends in the same place, so there is one path, not two.
fn tiles_palette_finish_drag(app) {
	if (app.pal_drag == null) { return 0; }

	let ts = tiles_current_set(app);
	let to = app.pal_drag_to;
	if (ts == null || to == null) {
		app.pal_drag = null;
		return 0;
	}

	let x0 = math_min(app.pal_drag[0], to[0]);
	let y0 = math_min(app.pal_drag[1], to[1]);
	let cols = math_abs(to[0] - app.pal_drag[0]) + 1;
	let rows = math_abs(to[1] - app.pal_drag[1]) + 1;
	app.brush = [ts.id, x0, y0, cols, rows];
	app.pal_drag = null;

	let what = "brush: " + ts.name + " " + x0 + "," + y0;
	if (cols > 1 || rows > 1) { what = what + " (" + cols + "x" + rows + ")"; }
	log_line(app, what);
	return 0;
}

fn tiles_palette_input(app, pressed, px, py, shift) {
	let r = tiles_palette_rect(app);
	if (r == null) { return false; }
	if (!point_in(app.mx, app.my, r[0], r[1], r[2], r[3])) { return false; }

	# while a block is being dragged out, remember how far it has got
	if (app.pal_drag != null) {
		let over = tiles_palette_cell_at(app, tiles_current_set(app), app.mx, app.my);
		if (over != null) { app.pal_drag_to = over; }
	}

	# the wheel scrolls the sheet instead of zooming the camera
	if (app.wheel != 0) {
		tiles_palette_scroll_by(app, -app.wheel * 48);
		app.wheel = 0;
	}

	if (!pressed || !point_in(px, py, r[0], r[1], r[2], r[3])) { return true; }

	let arrows = tiles_palette_arrows(app);
	if (arrows != null) {
		if (point_in(px, py, arrows[0][0], arrows[0][1], arrows[0][2], arrows[0][3])) {
			tiles_pick_set(app, -1);
			return true;
		}
		if (point_in(px, py, arrows[1][0], arrows[1][1], arrows[1][2], arrows[1][3])) {
			tiles_pick_set(app, 1);
			return true;
		}
	}

	let ts = tiles_current_set(app);
	let cell = tiles_palette_cell_at(app, ts, px, py);
	if (cell != null) {
		# Shift on the sheet is the same gesture as Shift on the scene, one
		# level up: there it rubs a cell out, here it says this tile is not
		# something to walk into -- or that it is.
		if (shift) {
			tiles_toggle_tile_solid(app, ts, cell[0], cell[1]);
			return true;
		}

		# the brush follows the press at once, so a click is a brush even if
		# the release lands somewhere the palette never sees
		app.brush = [ts.id, cell[0], cell[1], 1, 1];
		app.pal_drag = [cell[0], cell[1]];
		app.pal_drag_to = [cell[0], cell[1]];
	}
	return true;
}

fn tiles_palette_draw(app) {
	let r = tiles_palette_rect(app);
	if (r == null) { return 0; }

	love_graphics_setColor(18, 20, 26, 235);
	love_geometry_rectangle("fill", r[0], r[1], r[2], r[3]);
	love_graphics_setColor(70, 76, 90, 255);
	love_geometry_rectangle("line", r[0], r[1], r[2], r[3]);

	let ts = tiles_current_set(app);
	if (ts == null) {
		love_graphics_setColor(190, 195, 205, 255);
		love_graphics_print("No spritesheet yet.", r[0] + PAL_PAD, r[1] + 6);
		love_graphics_print("Inspector > Tilemap > Add sheet",
			r[0] + PAL_PAD, r[1] + 6 + love_font_getHeight() + 4);
		love_graphics_setColor(255, 255, 255, 255);
		return 0;
	}

	# --- header ---
	love_graphics_setColor(230, 232, 240, 255);
	let title = ts.name;
	if (len(tiles_sets(app)) > 1) {
		title = title + "  (" + (tiles_set_index(app, ts.id) + 1) + "/" +
			len(tiles_sets(app)) + ")";
	}
	love_graphics_print(title, r[0] + PAL_PAD, r[1] + 5);

	let arrows = tiles_palette_arrows(app);
	if (arrows != null) {
		for (let i = 0; i < 2; i++) {
			let a = arrows[i];
			let hot = point_in(app.mx, app.my, a[0], a[1], a[2], a[3]);
			if (hot) {
				love_graphics_setColor(120, 170, 255, 255);
			} else {
				love_graphics_setColor(90, 96, 112, 255);
			}
			love_geometry_rectangle("fill", a[0], a[1], a[2], a[3]);
			love_graphics_setColor(235, 238, 245, 255);
			let glyph = "<";
			if (i == 1) { glyph = ">"; }
			love_graphics_print(glyph, a[0] + 5, a[1] + 1);
		}
	}

	# --- the sheet ---
	let area = tiles_palette_sheet_rect(app);
	let img = tileset_image(app, ts);
	if (img == null) {
		love_graphics_setColor(230, 140, 140, 255);
		love_graphics_print("cannot load " + ts.path, area[0], area[1]);
		love_graphics_setColor(255, 255, 255, 255);
		return 0;
	}

	# glScissor's origin is the bottom left, unlike every other call here --
	# the same note as in view_draw()
	love_graphics_setScissor(area[0], app.screen_h - area[1] - area[3], area[2], area[3]);

	let scale = tiles_palette_scale(app, ts);
	let ox = area[0];
	let oy = area[1] - app.pal_scroll;

	love_graphics_setColor(255, 255, 255, 255);
	love_graphics_draw(img, ox, oy, 0, scale, scale);

	# the grid the sheet is cut on, so a wrong tile size is visible rather
	# than merely wrong
	let cols = tileset_columns(app, ts);
	let rows = tileset_rows(app, ts);
	love_graphics_setColor(120, 130, 150, 120);
	for (let tx = 0; tx <= cols; tx++) {
		let x = ox + (ts.margin + tx * (ts.tile_w + ts.spacing)) * scale;
		love_geometry_line([x, oy + ts.margin * scale,
			x, oy + (ts.margin + rows * (ts.tile_h + ts.spacing)) * scale]);
	}
	for (let ty = 0; ty <= rows; ty++) {
		let y = oy + (ts.margin + ty * (ts.tile_h + ts.spacing)) * scale;
		love_geometry_line([ox + ts.margin * scale, y,
			ox + (ts.margin + cols * (ts.tile_w + ts.spacing)) * scale, y]);
	}

	# The tiles that collide wherever they are painted, marked with a corner
	# rather than a full outline: the brush and the hover want the outline,
	# and three rectangles around one tile say nothing.
	let solid_size = math_max(3, math_floor(ts.tile_w * scale * 0.22));
	for (let ty = 0; ty < rows; ty++) {
		for (let tx = 0; tx < cols; tx++) {
			if (!tileset_is_solid(ts, tx, ty)) { continue; }
			let mark = tileset_src(ts, tx, ty);
			love_graphics_setColor(120, 190, 255, 230);
			love_geometry_rectangle("fill", ox + mark[0] * scale, oy + mark[1] * scale,
				solid_size, solid_size);
		}
	}

	# what the mouse is over, and what the brush is set to
	let hover = tiles_palette_cell_at(app, ts, app.mx, app.my);
	if (hover != null) {
		let src = tileset_src(ts, hover[0], hover[1]);
		love_graphics_setColor(255, 255, 255, 160);
		love_geometry_rectangle("line", ox + src[0] * scale, oy + src[1] * scale,
			src[2] * scale, src[3] * scale);
	}
	if (app.brush != null && app.brush[0] == ts.id) {
		let src = tileset_src(ts, app.brush[1], app.brush[2]);
		let bw = (brush_cols(app.brush) * (ts.tile_w + ts.spacing) - ts.spacing) * scale;
		let bh = (brush_rows(app.brush) * (ts.tile_h + ts.spacing) - ts.spacing) * scale;
		love_graphics_setColor(255, 214, 90, 255);
		love_geometry_rectangle("line", ox + src[0] * scale, oy + src[1] * scale,
			bw, bh);
	}

	# the block being dragged out, while the button is down
	if (app.pal_drag != null && app.pal_drag_to != null) {
		let x0 = math_min(app.pal_drag[0], app.pal_drag_to[0]);
		let y0 = math_min(app.pal_drag[1], app.pal_drag_to[1]);
		let cols_d = math_abs(app.pal_drag_to[0] - app.pal_drag[0]) + 1;
		let rows_d = math_abs(app.pal_drag_to[1] - app.pal_drag[1]) + 1;
		let corner = tileset_src(ts, x0, y0);
		love_graphics_setColor(120, 220, 255, 255);
		love_geometry_rectangle("line", ox + corner[0] * scale, oy + corner[1] * scale,
			(cols_d * (ts.tile_w + ts.spacing) - ts.spacing) * scale,
			(rows_d * (ts.tile_h + ts.spacing) - ts.spacing) * scale);
	}

	love_graphics_setScissor();
	# the viewport's own clip, which this borrowed for a moment
	love_graphics_setScissor(app.vp_x, app.screen_h - app.vp_y - app.vp_h,
		app.vp_w, app.vp_h);

	# --- footer ---
	love_graphics_setColor(150, 158, 175, 255);
	let footer = cols + "x" + rows + " tiles";
	if (app.brush != null && app.brush[0] == ts.id) {
		footer = footer + "   brush " + app.brush[1] + "," + app.brush[2];
		if (brush_cols(app.brush) > 1 || brush_rows(app.brush) > 1) {
			footer = footer + " " + brush_cols(app.brush) + "x" + brush_rows(app.brush);
		}
		if (tileset_is_solid(ts, app.brush[1], app.brush[2])) {
			footer = footer + " solid";
		}
	} else {
		footer = footer + "   click or drag a block, Shift for solid";
	}
	love_graphics_print(footer, r[0] + PAL_PAD, r[1] + r[3] - PAL_FOOTER + 2);
	love_graphics_setColor(255, 255, 255, 255);
	return 0;
}


# ============================================================================
#  The panel
# ============================================================================
#
#  Everything about the map that is a setting rather than a picture: the cell
#  size, the sheets and how they are cut, and the layers. It is a section of
#  the inspector, so it is beside the entity fields rather than in a window of
#  its own -- a map and the things standing on it are one level.

fn tiles_clamp_tile(v) {
	let n = math_floor(v + 0.5);
	if (n < TILE_MIN) { n = TILE_MIN; }
	if (n > TILE_MAX) { n = TILE_MAX; }
	return n;
}

# The brush, as a crop on the selected entities' sprite: the other half of
# "extract a tile from a sheet", for the things that move rather than the
# ground they stand on.
fn tiles_apply_to_selection(app) {
	if (app.brush == null) { return 0; }
	let ts = tiles_find_set(app, app.brush[0]);
	if (ts == null) { return 0; }

	let sel = doc_selected_entities(app);
	if (len(sel) == 0) { return 0; }

	doc_begin_edit(app);
	let src = tileset_src(ts, app.brush[1], app.brush[2]);
	for (let i = 0; i < len(sel); i++) {
		sel[i].sprite = { "path": ts.path, "quad": [src[0], src[1], src[2], src[3]] };
	}
	love_ui_clear_textbox(SPRITE_BOX);
	log_line(app, "sprite: " + ts.name + " " + app.brush[1] + "," + app.brush[2] +
		" on " + len(sel));
	return 0;
}

# A tile is static geometry: the solid ones are merged into static shapes when
# Play starts, and a merged shape has nowhere to keep a body of its own. So a
# crate that is meant to be pushed around cannot be a cell however it is
# flagged -- it is an entity that happens to wear the same tile.
#
# This makes that entity: a dynamic body one cell big, in the middle of the
# view, carrying the brush's tile as its artwork. Everything else about it is
# the inspector's business afterwards.
fn tiles_entity_from_brush(app) {
	if (app.brush == null) { return 0; }
	let ts = tiles_find_set(app, app.brush[0]);
	if (ts == null) { return 0; }

	let m = tiles_map(app);
	let cx = app.cam.x + (app.vp_w * 0.5) / app.cam.zoom;
	let cy = app.cam.y + (app.vp_h * 0.5) / app.cam.zoom;

	doc_begin_edit(app);
	let e = doc_add(app, ts.name + " " + app.brush[1] + "," + app.brush[2], "rect",
		snap_value(app, cx - m.tile_w * 0.5), snap_value(app, cy - m.tile_h * 0.5),
		m.tile_w, m.tile_h, 255, 255, 255);

	let src = tileset_src(ts, app.brush[1], app.brush[2]);
	e.sprite = { "path": ts.path, "quad": [src[0], src[1], src[2], src[3]] };
	e.body.type = "dynamic";

	doc_select_only(app, e.id);
	app.tool = "select";      # it is an entity now; the next click should pick it
	log_line(app, "entity from tile: " + e.name);
	return 0;
}

fn tiles_sheet_section(app) {
	let sets = tiles_sets(app);

	love_ui_layout_row(1, [-1], 0);
	if (len(sets) == 0) {
		love_ui_label("no sheet yet");
	}
	for (let i = 0; i < len(sets); i++) {
		let ts = sets[i];
		# two sheets can have the same file name, and microui hashes a
		# button's label into its id
		love_ui_pushId(ts.id);
		let mark = "  ";
		if (app.tile_set == ts.id) { mark = "> "; }
		if (love_ui_button(mark + ts.name, ALIGN_LEFT)) {
			app.tile_set = ts.id;
			app.pal_scroll = 0;
		}
		love_ui_popId();
	}

	love_ui_layout_row(2, [-90, -1], 0);
	if (love_ui_button("Add sheet...", ALIGN_CENTER)) { browser_open_tileset(app); }
	tip(app, "Pick a spritesheet. Only its path is stored -- relative when " +
		"the file is inside the game folder, absolute otherwise.");
	if (ui_button_enabled("Remove", len(sets) > 0, ALIGN_CENTER)) {
		tiles_remove_set(app, app.tile_set);
	}
	tip(app, "Take the sheet out of the level, and with it every cell painted " +
		"from it.");

	let ts = tiles_current_set(app);
	if (ts == null) { return 0; }

	love_ui_layout_row(3, [46, 74, -1], 0);
	love_ui_label("Tile:");
	let tw = tiles_clamp_tile(love_ui_number(ts.tile_w, 1, ID_NUM_TILE_W, ALIGN_CENTER, 0));
	let th = tiles_clamp_tile(love_ui_number(ts.tile_h, 1, ID_NUM_TILE_H, ALIGN_CENTER, 0));
	if (tw != ts.tile_w || th != ts.tile_h) {
		doc_begin_edit(app);
		ts.tile_w = tw;
		ts.tile_h = th;
		app.brush = null;
	}
	tip(app, "How big one tile is in this sheet, in pixels. The grid drawn " +
		"over the palette is this, so a wrong size is visible rather than " +
		"merely wrong.");

	love_ui_label("Gaps:");
	let margin = math_max(0, math_floor(love_ui_number(ts.margin, 1, ID_NUM_MARGIN, ALIGN_CENTER, 0) + 0.5));
	let spacing = math_max(0, math_floor(love_ui_number(ts.spacing, 1, ID_NUM_SPACING, ALIGN_CENTER, 0) + 0.5));
	if (margin != ts.margin || spacing != ts.spacing) {
		doc_begin_edit(app);
		ts.margin = margin;
		ts.spacing = spacing;
		app.brush = null;
	}
	tip(app, "Margin around the sheet, then spacing between two tiles. Both " +
		"are what a packer leaves behind; both are zero in a plain grid.");

	love_ui_layout_row(1, [-1], 0);
	let img = tileset_image(app, ts);
	if (img == null) {
		love_ui_label("cannot load " + ts.path);
	} else {
		love_ui_label(tileset_columns(app, ts) + "x" + tileset_rows(app, ts) +
			" tiles of " + love_image_getWidth(img) + "x" + love_image_getHeight(img));
	}

	if (app.brush == null || app.brush[0] != ts.id) {
		love_ui_label("pick a tile to say whether it is solid");
		return 0;
	}
	return tiles_tile_section(app, ts, app.brush[1], app.brush[2]);
}

# What one tile is: solid or not, and what it collides as when it is. The
# fields are the fixture's, because that is what a run of these cells becomes
# -- so a patch of ice is friction 0.05 here rather than a special case
# somewhere in a game.
fn tiles_tile_section(app, ts, tx, ty) {
	# The brush's own flag: this tile collides wherever it is painted, in any
	# layer. Off by default, and off again on a second click -- a level full of
	# solid grass is a level nobody can walk through.
	let solid = tileset_is_solid(ts, tx, ty);
	if (love_ui_checkbox("tile " + tx + "," + ty + " is solid", solid,
	                     TILE_CHECK_BASE + 2)) {
		tiles_toggle_tile_solid(app, ts, tx, ty);
		return 0;                # the settings below belong to the old answer
	}
	tip(app, "Collision for this tile wherever it is painted, whatever layer " +
		"it lands in -- Shift+click on the sheet does the same. A layer marked " +
		"solid collides anyway; this is for the stone block in a layer of " +
		"grass that is not.");

	let t = tile_settings(ts, tx, ty);
	if (t == null) { return 0; }

	love_ui_layout_row(3, [64, 56, -1], 0);
	love_ui_label("Friction:");
	let friction = round_to(math_max(0, love_ui_number(t.friction, 0.01,
		ID_NUM_TILE_FRICTION)), 3);
	love_ui_label("");
	love_ui_label("Bounce:");
	let bounce = round_to(math_max(0, love_ui_number(t.restitution, 0.01,
		ID_NUM_TILE_BOUNCE)), 3);
	love_ui_label("");
	if (friction != t.friction || bounce != t.restitution) {
		doc_begin_edit(app);
		t.friction = friction;
		t.restitution = bounce;
	}
	tip(app, "What a run of these cells rubs and bounces like. Two cells only " +
		"merge into one shape when they collide alike, so a patch of ice keeps " +
		"its own friction rather than taking the floor's.");

	love_ui_layout_row(1, [-1], 0);
	if (love_ui_checkbox("sensor", t.sensor, TILE_CHECK_BASE + 3)) {
		doc_begin_edit(app);
		t.sensor = !t.sensor;
	}
	tip(app, "Reports the touch and lets it through -- water, a trigger, the " +
		"bottom of a pit. Outlined in green rather than grey by Show fixtures.");

	love_ui_layout_row(2, [64, -1], 0);
	love_ui_label("Name:");
	let box = love_ui_textbox(TILE_NAME_BOX, t.name);
	if (box[0] != 0 && box[1] != t.name) {
		doc_begin_edit(app);
		t.name = box[1];
	}
	tip(app, "What a contact callback is handed when something hits this tile. " +
		"A merged run has no entity behind it, so without a name a game can " +
		"only tell that it hit the map -- with one it can tell ice from lava. " +
		"An entity's user data is its id, a number; this is a string.");

	# Box2D's filter, the same two bit fields an entity's fixture has
	let category = inspector_bit_row(app, "layer:", t.category, ID_TILE_CATEGORY);
	let mask = inspector_bit_row(app, "hits:", t.mask, ID_TILE_MASK);
	if (category != t.category || mask != t.mask) {
		doc_begin_edit(app);
		t.category = category;
		t.mask = mask;
	}
	tip(app, "layer is what these cells are, hits is what they are willing to " +
		"touch -- two fixtures collide only when each one's layer is in the " +
		"other's mask.");
	return 0;
}

fn tiles_layer_section(app) {
	let layers = tiles_layers(app);
	let current = tiles_current_layer(app);

	for (let i = 0; i < len(layers); i++) {
		let layer = layers[i];
		love_ui_pushId(layer.id);

		love_ui_layout_row(3, [78, 46, -1], 0);
		let mark = "  ";
		if (current != null && current.id == layer.id) { mark = "> "; }
		if (love_ui_button(mark + layer.name, ALIGN_LEFT)) { app.tile_layer = layer.id; }

		if (love_ui_checkbox("vis", layer.visible, TILE_CHECK_BASE)) {
			doc_begin_edit(app);
			layer.visible = !layer.visible;
		}
		if (love_ui_checkbox("solid", layer.solid, TILE_CHECK_BASE + 1)) {
			doc_begin_edit(app);
			layer.solid = !layer.solid;
		}
		tip(app, "A solid layer becomes static collision when Play runs: each " +
			"row of touching cells as one rectangle, so nothing catches on " +
			"the seam between two tiles.");

		love_ui_popId();
	}

	love_ui_layout_row(4, [58, 58, 58, -1], 0);
	if (love_ui_button("Add", ALIGN_CENTER)) { tiles_add_layer(app); }
	if (ui_button_enabled("Delete", len(layers) > 1, ALIGN_CENTER)) {
		tiles_delete_layer(app, app.tile_layer);
	}
	if (love_ui_button("Down", ALIGN_CENTER)) { tiles_move_layer(app, app.tile_layer, -1); }
	if (love_ui_button("Up", ALIGN_CENTER)) { tiles_move_layer(app, app.tile_layer, 1); }
	tip(app, "This list is the draw order, front last -- the same rule the " +
		"hierarchy follows for entities.");

	# Renaming the current one. The box is seeded from the layer, so it has to
	# be handed back to microui when the current layer changes -- editor_update
	# does that, the same way it does for the entity fields.
	if (current != null) {
		love_ui_layout_row(2, [64, -1], 0);
		love_ui_label("Name:");
		let box = love_ui_textbox(LAYER_NAME_BOX, current.name);
		if (box[0] != 0 && len(box[1]) > 0 && box[1] != current.name) {
			doc_begin_edit(app);
			current.name = box[1];
		}
	}

	love_ui_layout_row(2, [-90, -1], 0);
	let cells = 0;
	if (current != null) { cells = len(current.cells); }
	love_ui_label(cells + " cells here");
	if (ui_button_enabled("Clear", cells > 0, ALIGN_CENTER)) {
		tiles_clear_layer(app, current);
	}
	return 0;
}

# --- what a click does ------------------------------------------------------
#
#  Three ways to lay tiles down and one switch that turns any of them into the
#  opposite. Shift still erases whatever the switch says, so the quick way and
#  the sustained way are both there: holding a key is right for one cell and
#  wrong for a hundred.

fn tiles_mode_button(app, mode, label) {
	let caption = "  " + label;
	if (app.tile_mode == mode) { caption = "> " + label; }
	if (love_ui_button(caption, ALIGN_CENTER)) { app.tile_mode = mode; }
	return 0;
}

fn tiles_mode_section(app) {
	love_ui_layout_row(3, [72, 72, -1], 0);
	tiles_mode_button(app, "brush", "Brush");
	tiles_mode_button(app, "rect", "Rect");
	tiles_mode_button(app, "fill", "Fill");

	# its own row: a checkbox is a box and a word, and the three buttons above
	# had already taken the width
	love_ui_layout_row(1, [-1], 0);
	if (love_ui_checkbox("erase (or hold Shift)", app.tile_erase,
	                     TILE_CHECK_BASE + 4)) {
		app.tile_erase = !app.tile_erase;
	}
	tip(app, "Brush paints the cell under the cursor, and drags a stroke. " +
		"Rect fills the rectangle you drag out. Fill replaces the run of " +
		"identical tiles you click on, and never spreads into empty space. " +
		"Erase turns whichever of them into its opposite -- so does holding " +
		"Shift, which is quicker for one cell and worse for a hundred.");
	return 0;
}

fn tiles_panel(app) {
	let opt = 0;
	if (app.tool == "tile") { opt = OPT_EXPANDED; }
	if (!love_ui_header("Tilemap", opt)) { return 0; }

	let m = tiles_map(app);

	love_ui_layout_row(3, [46, 74, -1], 0);
	love_ui_label("Cell:");
	let cw = tiles_clamp_tile(love_ui_number(m.tile_w, 1, ID_NUM_CELL_W, ALIGN_CENTER, 0));
	let ch = tiles_clamp_tile(love_ui_number(m.tile_h, 1, ID_NUM_CELL_H, ALIGN_CENTER, 0));
	if (cw != m.tile_w || ch != m.tile_h) {
		doc_begin_edit(app);
		m.tile_w = cw;
		m.tile_h = ch;
	}
	tip(app, "How big a cell of the map is, in world units. A sheet whose " +
		"tiles are a different size is scaled onto it rather than leaving a " +
		"gap, so this is the map's grid, not the artwork's.");

	love_ui_layout_row(1, [-1], 0);
	if (love_ui_button("Paint tiles", ALIGN_CENTER)) {
		app.tool = "tile";
		app.pal_open = true;
		log_line(app, "tool: tile -- click paints, Shift erases");
	}
	if (app.tool == "tile") { tiles_mode_section(app); }
	tip(app, "The Tiles tool: the palette opens over the viewport, a click " +
		"paints the cell under the cursor and Shift+click rubs it out.");

	if (love_ui_header("Sheets", OPT_EXPANDED)) { tiles_sheet_section(app); }
	if (love_ui_header("Layers", OPT_EXPANDED)) { tiles_layer_section(app); }

	love_ui_layout_row(1, [-1], 0);
	if (ui_button_enabled("Brush -> selected sprite",
	                      app.brush != null && doc_selected(app) != null,
	                      ALIGN_CENTER)) {
		tiles_apply_to_selection(app);
	}
	tip(app, "Give everything selected the brush's tile as its sprite -- the " +
		"same sheet, cropped to that one tile. Entities take a tile the same " +
		"way the map does.");

	if (ui_button_enabled("Brush -> new entity", app.brush != null, ALIGN_CENTER)) {
		tiles_entity_from_brush(app);
	}
	tip(app, "A dynamic body one cell big, in the middle of the view, wearing " +
		"the brush's tile -- for the crate that is meant to be pushed around. " +
		"A painted cell can never be that: the solid ones become static shapes " +
		"when Play starts.");
	return 0;
}
