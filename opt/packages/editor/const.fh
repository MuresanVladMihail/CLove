# ============================================================================
#  const.fh -- shared constants
# ----------------------------------------------------------------------------
#  include "include" is textual, so this file has to come first: FH resolves a
#  global where it is declared, and every other module reads these.
# ============================================================================

# The engine hands several callbacks no state map at all -- the input ones, and
# the collision ones, which are looked up by *name* from C. What they can do is
# park what they were told here until the next update picks it up, and reach
# the editor through `app`. A map rather than plain globals because a global
# `let` in FH is a constant binding: the name cannot be reassigned, though the
# map it points at is free to change.
let EDITOR_INPUT = { "press": null, "released": false, "app": null, "keys": [] };

# --- microui flags ----------------------------------------------------------
# love_ui_opt() and love_ui_align() name some of microui's MU_OPT_* flags; the
# rest are plain bit values from src/3rdparty/microui/src/microui.h, and they
# combine by addition.
let ALIGN_LEFT   = 0;
let ALIGN_CENTER = 1;      # MU_OPT_ALIGNCENTER
let OPT_EXPANDED = 4096;   # MU_OPT_EXPANDED -- headers and trees start open
let OPT_DISABLED = 4;      # MU_OPT_NOINTERACT -- draws, never fires

# --- layout -----------------------------------------------------------------
# The panel metrics are fixed; the window is not. Everything else (the screen
# size and the viewport the scene is drawn into) is recomputed each frame from
# the actual window by editor_layout(), so the editor fits whatever it is
# hosted in -- a game's window is not going to be 1280x760 because the editor
# would like it to be.
let PANEL_W   = 250;
let TOOLBAR_H = 76;
let STATUS_H  = 30;
let HIER_H    = 400;   # the hierarchy's share of the left column, by default

# Below these the panels would leave nothing to draw into, so the viewport
# stops shrinking and starts being covered instead. Better a cramped editor
# than a negative-width one.
let MIN_VP_W = 120;
let MIN_VP_H = 120;

fn editor_layout(app) {
	app.screen_w = love_window_getWidth();
	app.screen_h = love_window_getHeight();

	# The hierarchy keeps its height until the window is too short for it, and
	# then gives way rather than pushing the console off the bottom.
	app.hier_h = HIER_H;
	let column = app.screen_h - TOOLBAR_H;
	if (app.hier_h > column - MIN_VP_H) { app.hier_h = column - MIN_VP_H; }
	if (app.hier_h < MIN_VP_H) { app.hier_h = MIN_VP_H; }

	app.vp_x = PANEL_W;
	app.vp_y = TOOLBAR_H;
	app.vp_w = app.screen_w - 2 * PANEL_W;
	app.vp_h = app.screen_h - TOOLBAR_H - STATUS_H;

	if (app.vp_w < MIN_VP_W) { app.vp_w = MIN_VP_W; }
	if (app.vp_h < MIN_VP_H) { app.vp_h = MIN_VP_H; }
	return 0;
}

# --- modal dialogs ----------------------------------------------------------
# A modal is sized from the number of content rows it holds rather than by a
# hand-tuned number, so adding a line of text does not leave the window with a
# third of it empty (or clip the buttons). The constants are microui's own
# metrics: title_height, and a default row of style.size.y + 2*padding with
# spacing under it.
let DIALOG_W       = 400;
let DIALOG_TITLE_H = 24;
let DIALOG_ROW_H   = 24;
let DIALOG_PAD     = 14;

fn dialog_height(rows) {
	return DIALOG_TITLE_H + DIALOG_PAD + rows * DIALOG_ROW_H;
}

fn dialog_x(app, w) { return math_floor((app.screen_w - w) * 0.5); }
fn dialog_y(app, h) { return math_floor((app.screen_h - h) * 0.5); }

# --- toolbar metrics --------------------------------------------------------
# Both toolbar rows share these so their groups line up: one action button is
# always TB_BTN wide, a menu button TB_MENU, and TB_GAP separates two groups.
let TB_BTN  = 84;
let TB_MENU = 170;
let TB_GAP  = 14;

# The level opened when there is nothing remembered in editor.json. Every
# other level is discovered from the game directory -- see scenes.fh.
let SCENE_PATH  = "scene.json";
let PREFS_PATH  = "editor.json";
let DOC_VERSION = 1;
let UNDO_LIMIT  = 40;

# --- grid -------------------------------------------------------------------
# The grid step is in world units and is what Snap rounds to, so it has to stay
# a positive number: snap_value() divides by it.
let GRID_DEFAULT = 20;
let GRID_MIN     = 1;
let GRID_MAX     = 512;

# --- widget ids -------------------------------------------------------------
# microui derives a widget's id from its label, and for sliders, number fields
# and text boxes from the address it is handed -- which is the same stack slot
# on every call. Every one of those therefore needs an id of its own here, or
# they collide and none of them respond.
let NAME_BOX      = 1;
let SPRITE_BOX    = 2;
let GROUP_BOX     = 3;
let NEW_SCENE_BOX = 4;
let PROP_KEY_BOX  = 5;
let PROP_VAL_BOX  = 6;
let LINK_KEY_BOX  = 7;

let ID_NUM_X       = 10;
let ID_NUM_Y       = 11;
let ID_NUM_W       = 12;
let ID_NUM_H       = 13;
let ID_NUM_ANGLE   = 14;
let ID_NUM_DENSITY = 15;
let ID_NUM_FRICTION = 16;
let ID_NUM_BOUNCE  = 17;
let ID_NUM_GRAVITY = 18;

let ID_NUM_GRID    = 19;
let ID_NUM_GRAV_X  = 23;
let ID_NUM_GRAV_Y  = 24;
let ID_NUM_METER   = 25;

let ID_COL_R = 20;
let ID_COL_G = 21;
let ID_COL_B = 22;

let ID_STYLE_BASE = 40;   # the theme editor uses 40..59

# --- gizmo ------------------------------------------------------------------
let HANDLE_HALF = 5;    # grip half-size, screen pixels
let ARROW_LEN   = 52;   # axis arrow length, screen pixels
let ROT_OFFSET  = 30;   # rotate knob, screen pixels above the top edge
let ROT_SNAP    = 15;   # degrees, when Snap is on

let MAX_HULL_POINTS = 8;   # Box2D's polygon vertex limit

# microui works in `float` (mu_Real), so a value that has been through a slider
# or a number field comes back as 0.40000000596046448 rather than 0.4.
# Quantising on the way into the document keeps the saved JSON clean and its
# diffs readable.
fn round_to(v, places) {
	let m = math_pow(10, places);
	return math_floor(v * m + 0.5) / m;
}

# --- collision filter bits --------------------------------------------------
# Box2D's filter is two bit fields: category is what a fixture *is*, mask is
# what it is willing to touch. The inspector shows the low FILTER_BITS of each
# as toggles -- the document holds the full 16, so a hand-edited level can use
# the rest.
let FILTER_BITS = 8;

fn bit_has(value, i) { return (value & (1 << i)) != 0; }

fn bit_toggle(value, i) {
	if (bit_has(value, i)) { return value - (1 << i); }
	return value | (1 << i);
}


# New entities cycle through these, so a scene of untextured boxes is still
# readable. Shared by every tool that makes one.
let PALETTE = [
	[214, 93, 93], [93, 176, 214], [140, 200, 110],
	[220, 170, 80], [170, 130, 220], [90, 200, 190]
];

fn next_colour(app) {
	let c = PALETTE[app.pal_i];
	app.pal_i = app.pal_i + 1;
	if (app.pal_i >= len(PALETTE)) { app.pal_i = 0; }
	return c;
}


# --- the editor's own look --------------------------------------------------
#
# The theme the editor starts in, and the one Revert goes back to. It is here
# rather than captured from microui at startup because "the original" has to
# mean something fixed: once a customised theme is remembered in editor.json,
# what microui holds at startup is the customised one.
#
# Names are love_ui_getColor()/setColor()'s, and only the ones the Theme editor
# offers are listed -- microui's other slots keep its own defaults.
let THEME_DEFAULT = [
	["windowBg",    [50, 50, 50]],
	["button",      [75, 75, 75]],
	["buttonHover", [95, 95, 95]],
	["text",        [230, 230, 230]],
	["border",      [25, 25, 25]]
];

fn theme_apply(app, table) {
	for (let i = 0; i < len(table); i = i + 1) {
		let name = table[i][0];
		let rgb = table[i][1];
		let c = love_ui_getColor(name);
		# c[4] is the MU_COLOR_* id the name resolved to, c[3] its alpha
		love_ui_setColor(c[4], rgb[0], rgb[1], rgb[2], c[3]);
	}
	return 0;
}

# What the Theme editor is showing right now, in the same shape, so it can be
# written to editor.json and read back.
fn theme_current(app) {
	let out = [];
	for (let i = 0; i < len(THEME_DEFAULT); i = i + 1) {
		let name = THEME_DEFAULT[i][0];
		let c = love_ui_getColor(name);
		append(out, [name, [c[0], c[1], c[2]]]);
	}
	return out;
}


# --- tooltips ---------------------------------------------------------------
#
# Called straight after a widget: love_ui_hovered() answers for the one just
# built, so a tip is one line under whatever it explains rather than a table of
# rectangles kept in step by hand.
#
#     if (love_ui_button("Play", ALIGN_CENTER)) { sim_play(app); }
#     tip(app, "Build a Box2D world from the level and run it.");
#
# The text is parked on the app and drawn once at the end of the frame, in a
# window of its own so it lands over the panels rather than under them.

let TIP_W       = 300;
let TIP_PAD     = 16;
let TIP_LINE    = 18;
let TIP_OFFSET  = 18;   # from the cursor, so the pointer does not cover it

fn tip(app, text) {
	if (!app.tips) { return 0; }
	if (love_ui_hovered()) { app.tip = text; }
	return 0;
}

# One window, moved to the cursor each frame and raised above everything --
# microui applies a window's rect only the first time it sees it, and only
# raises one when it is clicked, so both have to be said every frame.
fn tip_draw(app) {
	if (app.tip == null) { return 0; }

	# Measured, not guessed at so many characters per line: a tip that wrapped
	# to one more line than the count assumed had its last line cut off by the
	# window it was drawn in.
	let usable = TIP_W - TIP_PAD * 2;
	let lines = math_floor(love_font_getWidth(app.tip) / usable) + 1;
	let h = TIP_PAD + lines * TIP_LINE;
	let x = app.mx + TIP_OFFSET;
	let y = app.my + TIP_OFFSET;

	# keep it on screen: flip to the other side of the cursor at the edges
	if (x + TIP_W > app.screen_w) { x = app.mx - TIP_W - TIP_OFFSET; }
	if (y + h > app.screen_h) { y = app.my - h - TIP_OFFSET; }

	love_ui_setWindowRect("tip", x, y, TIP_W, h);
	love_ui_bringToFront("tip");

	let opts = love_ui_opt("notitle") + love_ui_opt("noresize") +
		love_ui_opt("noclose") + love_ui_opt("noscroll");
	if (love_ui_begin_window("tip", x, y, TIP_W, h, opts)) {
		love_ui_layout_row(1, [-1], 0);
		love_ui_text(app.tip);
		love_ui_end_window();
	}
	app.tip = null;
	return 0;
}


# A button that is drawn but does nothing when there is nothing for it to do.
# Greying out beats a button that looks live and silently ignores the click.
fn ui_button_enabled(label, enabled, align) {
	if (enabled) { return love_ui_button(label, align); }
	love_ui_button(label, align + OPT_DISABLED);
	return false;
}

fn point_in(x, y, rx, ry, rw, rh) {
	return x >= rx && x <= rx + rw && y >= ry && y <= ry + rh;
}

fn drop_first(arr) {
	let out = [];
	for (let i = 1; i < len(arr); i = i + 1) { append(out, arr[i]); }
	return out;
}

fn drop_last(arr) {
	let out = [];
	for (let i = 0; i < len(arr) - 1; i = i + 1) { append(out, arr[i]); }
	return out;
}

# --- paths ------------------------------------------------------------------
#
# Written against the string, not string_split(): split runs on strtok, which
# collapses runs of the delimiter, so "/a//b" and a leading "/" do not survive
# a round trip.

fn path_is_sep(c) {
	return c == "/" || c == "\\";
}

fn path_join(dir, name) {
	if (len(dir) == 0) { return name; }
	if (path_is_sep(string_substr(dir, len(dir) - 1, 1))) { return dir + name; }
	return dir + "/" + name;
}

# the directory holding `path`, or `path` itself once it is the root
fn path_parent(path) {
	let cut = -1;
	for (let i = 0; i < len(path); i = i + 1) {
		if (path_is_sep(string_substr(path, i, 1))) { cut = i; }
	}
	if (cut < 0) { return path; }
	if (cut == 0) { return "/"; }          # "/usr" -> "/"
	return string_substr(path, 0, cut);
}

fn path_name(path) {
	let cut = -1;
	for (let i = 0; i < len(path); i = i + 1) {
		if (path_is_sep(string_substr(path, i, 1))) { cut = i; }
	}
	if (cut < 0) { return path; }
	return string_substr(path, cut + 1, len(path) - cut - 1);
}

fn path_is_root(path) {
	return path == "/" || len(path) == 0 || path_parent(path) == path;
}

fn path_has_suffix(name, suffix) {
	if (len(name) < len(suffix)) { return false; }
	let tail = string_substr(name, len(name) - len(suffix), len(suffix));
	return string_lower(tail) == string_lower(suffix);
}

# `path` expressed relative to `base`, or null when it is not inside it
fn path_relative_to(path, base) {
	if (len(base) == 0 || len(path) <= len(base)) { return null; }
	if (string_substr(path, 0, len(base)) != base) { return null; }

	let rest = string_substr(path, len(base), len(path) - len(base));
	while (len(rest) > 0 && path_is_sep(string_substr(rest, 0, 1))) {
		rest = string_substr(rest, 1, len(rest) - 1);
	}
	if (len(rest) == 0) { return null; }
	return rest;
}


# The console lives on the shared app map, so every module can report without
# being handed the panel that renders it.
fn log_line(app, msg) {
	append(app.log, msg);
	if (len(app.log) > 80) {
		let trimmed = [];
		for (let i = 20; i < len(app.log); i = i + 1) { append(trimmed, app.log[i]); }
		app.log = trimmed;
	}
	return 0;
}
