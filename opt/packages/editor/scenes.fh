# ============================================================================
#  scenes.fh -- levels
# ----------------------------------------------------------------------------
#  A scene file is a level. The editor works on one at a time and switches
#  between them from the Scene menu in the toolbar.
#
#  The list is not stored anywhere: it is every *.json in the game directory
#  that is not the preferences file, read fresh each time the menu opens. Drop
#  a level in the folder and it is there; delete one and it is gone. What *is*
#  remembered, in editor.json, is which level you were on -- so reopening the
#  editor puts you back where you left off.
#
#  Switching with unsaved work goes through a modal first. Losing an hour of
#  level building to a menu click is not a trade anyone wants.
#
#  Functions are ordered callee-first: FH resolves a name where it is used, so
#  a function has to be defined above the one that calls it.
# ============================================================================


fn scenes_is_scene_file(name) {
	if (!path_has_suffix(name, ".json")) { return false; }
	return name != PREFS_PATH;
}

fn scenes_list(app) {
	let entries = love_filesystem_list(app.game_dir);
	if (entries == null) { return []; }

	let out = [];
	for (let i = 0; i < len(entries); i++) {
		let entry = entries[i];
		if (!entry.dir && scenes_is_scene_file(entry.name)) { append(out, entry.name); }
	}
	return out;
}

fn scenes_refresh(app) {
	let files = scenes_list(app);

	# A level created but not yet written has no file to be found, and leaving
	# it out of its own menu reads as if it were gone.
	let seen = false;
	for (let i = 0; i < len(files); i++) {
		if (files[i] == app.scene_path) { seen = true; }
	}
	if (!seen) { append(files, app.scene_path); }

	app.scene_files = files;
	return 0;
}

# level2.json, level3.json, ... -- the first name not already taken
fn scenes_suggest_name(app) {
	let taken = scenes_list(app);
	for (let n = 2; n < 100; n++) {
		let candidate = "level" + n + ".json";
		let free = true;
		for (let i = 0; i < len(taken); i++) {
			if (taken[i] == candidate) { free = false; }
		}
		if (free) { return candidate; }
	}
	return "level.json";
}


# --- switching --------------------------------------------------------------

# Where you were looking in each level, for this session. Switching to a level
# and back should put the view where you left it, not reframe the whole scene
# and make you find your way again. It is not written to editor.json: that
# would mean a file write every time the camera moved.
fn scenes_remember_camera(app) {
	app.cameras[app.scene_path] = {
		"x": app.cam.x, "y": app.cam.y, "zoom": app.cam.zoom
	};
	return 0;
}

fn scenes_restore_camera(app) {
	if (!contains_key(app.cameras, app.scene_path)) {
		cam_frame_all(app);   # first visit: show the whole level
		return 0;
	}
	let c = app.cameras[app.scene_path];
	app.cam.x = c.x;
	app.cam.y = c.y;
	app.cam.zoom = c.zoom;
	return 0;
}

fn scenes_open(app, path) {
	scenes_remember_camera(app);

	if (io_filetype(path) == "file") {
		if (!doc_load(app, path)) { return false; }
	} else {
		# a level that has not been written yet: start it empty
		app.doc_data = doc_empty(app);
		doc_select_none(app);
		app.undo = [];
		app.redo = [];
		app.dirty = true;
		doc_touch(app);
		log_line(app, "new level " + path);
	}

	app.scene_path = path;

	# the caches are keyed by path, and a level has its own art
	app.sprite_cache = {};
	app.trace_cache = {};
	app.piece_cache = {};

	prefs_touch(app);          # editor.json remembers the level you are on
	scenes_restore_camera(app);
	return true;
}

# Asks first when there is unsaved work; scenes_dialogs() finishes the job.
fn scenes_request(app, path) {
	if (path == app.scene_path) { return 0; }
	if (app.dirty) {
		app.scene_pending = path;
		return 0;
	}
	scenes_open(app, path);
	return 0;
}


# --- the toolbar menu -------------------------------------------------------

fn scenes_menu(app) {
	let label = app.scene_path;
	if (app.dirty) { label = app.scene_path + " *"; }

	if (love_ui_button(label, ALIGN_CENTER)) {
		scenes_refresh(app);
		love_ui_open_popup("scenes");
	}

	# microui leaves a popup open until something outside it is clicked, so a
	# menu that ought to close on a pick has to be closed by hand -- and from
	# out here, not from inside the body: love_ui_setWindowOpen() hashes the
	# name against the top of the id stack, which inside a popup is the popup's
	# own container rather than the window that opened it.
	let close_menu = false;

	if (love_ui_begin_popup("scenes")) {
		love_ui_layout_row(1, [200], 0);

		for (let i = 0; i < len(app.scene_files); i++) {
			let name = app.scene_files[i];
			let row = "  " + name;
			if (name == app.scene_path) { row = "> " + name; }

			# two levels never share a name, but the id stack costs nothing and
			# keeps this honest if one ever does
			love_ui_pushId(i);
			if (love_ui_button(row, ALIGN_LEFT)) {
				scenes_request(app, name);
				close_menu = true;
			}
			love_ui_popId();
		}

		if (len(app.scene_files) == 0) { love_ui_label("no levels yet"); }

		love_ui_label("");
		if (love_ui_button("New level...", ALIGN_LEFT)) {
			scenes_ask_name(app, "new", scenes_suggest_name(app));
			close_menu = true;
		}
		if (love_ui_button("Save as...", ALIGN_LEFT)) {
			scenes_ask_name(app, "copy", scenes_suggest_name(app));
			close_menu = true;
		}
		if (love_ui_button("Rename...", ALIGN_LEFT)) {
			scenes_ask_name(app, "rename", app.scene_path);
			close_menu = true;
		}
		if (love_ui_button("Delete level...", ALIGN_LEFT)) {
			app.delete_scene = app.scene_path;
			close_menu = true;
		}
		love_ui_end_popup();
	}

	if (close_menu) { love_ui_setWindowOpen("scenes", false); }

	# the click that dismisses this menu must not also land in the viewport
	if (love_ui_popup_open("scenes")) { app.popup_open = true; }
	return 0;
}


# --- the two modals ---------------------------------------------------------

fn scenes_unsaved_dialog(app) {
	if (app.scene_pending == null) { return 0; }

	let h = dialog_height(3);   # two wrapped lines of text, then the buttons
	if (love_ui_begin_window("Unsaved changes", dialog_x(app, DIALOG_W), dialog_y(app, h),
	                         DIALOG_W, h,
	                         love_ui_opt("noresize") + love_ui_opt("noclose"))) {
		love_ui_layout_row(1, [-1], 0);
		love_ui_text(app.scene_path + " has unsaved changes. Opening " +
			app.scene_pending + " will drop them.");

		love_ui_layout_row(3, [-190, -95, -1], 0);
		if (love_ui_button("Save first", ALIGN_CENTER)) {
			doc_save(app, app.scene_path);
			let next = app.scene_pending;
			app.scene_pending = null;
			scenes_open(app, next);
		}
		if (love_ui_button("Discard", ALIGN_CENTER)) {
			let next = app.scene_pending;
			app.scene_pending = null;
			scenes_open(app, next);
		}
		if (love_ui_button("Cancel", ALIGN_CENTER)) { app.scene_pending = null; }

		love_ui_end_window();
	}
	return 0;
}

# One dialog for the three commands that need a file name. They differ only in
# what the button says and what it does with the name, which is not enough to
# justify three near-identical modals -- or three text box ids, and microui
# only has so many.
fn scenes_ask_name(app, mode, suggestion) {
	love_ui_clear_textbox(NEW_SCENE_BOX);
	app.name_dialog = { "mode": mode, "name": suggestion };
	return 0;
}

fn scenes_dialog_title(mode) {
	if (mode == "copy") { return "Save as"; }
	if (mode == "rename") { return "Rename level"; }
	return "New level";
}

fn scenes_apply_name(app, mode, name) {
	if (mode == "new") {
		scenes_request(app, name);
		return 0;
	}

	if (mode == "copy") {
		# the document as it stands, written under the new name, and the
		# editor carries on there -- nothing is lost, so nothing to ask
		doc_save(app, name);
		scenes_remember_camera(app);
		app.scene_path = name;
		prefs_touch(app);
		return 0;
	}

	# rename: a level that has never been written has no file to move
	if (io_filetype(app.scene_path) == "file") {
		io_rename(app.scene_path, name);
	}
	log_line(app, app.scene_path + " -> " + name);
	app.scene_path = name;
	prefs_touch(app);
	return 0;
}

fn scenes_name_dialog(app) {
	if (app.name_dialog == null) { return 0; }

	let mode = app.name_dialog.mode;
	let h = dialog_height(3);   # label, text box, buttons
	if (love_ui_begin_window(scenes_dialog_title(mode),
	                         dialog_x(app, DIALOG_W), dialog_y(app, h), DIALOG_W, h,
	                         love_ui_opt("noresize") + love_ui_opt("noclose"))) {
		love_ui_layout_row(1, [-1], 0);
		love_ui_label("File name, next to " + PREFS_PATH + ":");

		let box = love_ui_textbox(NEW_SCENE_BOX, app.name_dialog.name);
		let name = string_trim(box[1]);

		love_ui_layout_row(2, [-95, -1], 0);
		if (love_ui_button("OK", ALIGN_CENTER)) {
			if (len(name) > 0) {
				if (!path_has_suffix(name, ".json")) { name = name + ".json"; }
				if (name == app.scene_path) {
					app.name_dialog = null;          # nothing to do
				} else if (io_filetype(name) == "file") {
					log_line(app, name + " already exists");
				} else {
					app.name_dialog = null;
					scenes_apply_name(app, mode, name);
				}
			}
		}
		if (love_ui_button("Cancel", ALIGN_CENTER)) { app.name_dialog = null; }

		love_ui_end_window();
	}
	return 0;
}

# Removing a level takes the file with it, so it asks first and names the file
# it is about to remove.
fn scenes_delete_dialog(app) {
	if (app.delete_scene == null) { return 0; }

	let h = dialog_height(3);
	if (love_ui_begin_window("Delete level", dialog_x(app, DIALOG_W), dialog_y(app, h),
	                         DIALOG_W, h,
	                         love_ui_opt("noresize") + love_ui_opt("noclose"))) {
		love_ui_layout_row(1, [-1], 0);
		love_ui_text("Delete " + app.delete_scene +
			"? The file is removed from disk and this cannot be undone.");

		love_ui_layout_row(2, [-95, -1], 0);
		if (love_ui_button("Delete", ALIGN_CENTER)) {
			let gone = app.delete_scene;
			app.delete_scene = null;
			scenes_delete(app, gone);
		}
		if (love_ui_button("Cancel", ALIGN_CENTER)) { app.delete_scene = null; }

		love_ui_end_window();
	}
	return 0;
}

fn scenes_delete(app, path) {
	if (io_filetype(path) == "file") { io_remove(path); }
	log_line(app, "deleted " + path);

	if (path != app.scene_path) { return 0; }

	# The level that was open is gone: fall back to whatever is left, or to an
	# empty scene.json when nothing is.
	app.dirty = false;          # there is no file to be dirty against
	let left = scenes_list(app);
	if (len(left) > 0) {
		app.scene_path = "";    # force scenes_request past its same-file check
		scenes_request(app, left[0]);
	} else {
		app.scene_path = "";
		scenes_request(app, SCENE_PATH);
	}
	return 0;
}

# Closing with unsaved work. Reached from Esc and, thanks to love_quit()
# answering true, from the window's close button too.
fn scenes_quit_dialog(app) {
	if (!app.quitting) { return 0; }

	let h = dialog_height(2);   # one line of text, then the buttons
	if (love_ui_begin_window("Quit", dialog_x(app, DIALOG_W), dialog_y(app, h),
	                         DIALOG_W, h,
	                         love_ui_opt("noresize") + love_ui_opt("noclose"))) {
		love_ui_layout_row(1, [-1], 0);
		love_ui_text(app.scene_path + " has unsaved changes.");

		love_ui_layout_row(3, [-190, -95, -1], 0);
		if (love_ui_button("Save and quit", ALIGN_CENTER)) {
			doc_save(app, app.scene_path);
			app.force_quit = true;
			love_mouse_setVisible(true);
			love_event_quit();
		}
		if (love_ui_button("Quit anyway", ALIGN_CENTER)) {
			app.force_quit = true;
			love_mouse_setVisible(true);
			love_event_quit();
		}
		if (love_ui_button("Cancel", ALIGN_CENTER)) { app.quitting = false; }

		love_ui_end_window();
	}
	return 0;
}

fn scenes_dialogs(app) {
	scenes_unsaved_dialog(app);
	scenes_name_dialog(app);
	scenes_delete_dialog(app);
	return 0;
}
