# Canvases: render to a texture, then draw that texture.
#
# The 10 000 sprites below are drawn once, into a canvas, at load time. After
# that every frame is a single draw of one texture -- which is why the frame
# rate does not care how many sprites went into it. Hold SPACE to draw them
# straight to the screen instead and watch it collapse.
#
#   cd opt/examples/fh/canvas && ../../../../build/clove

let COUNT = 10000;
let SIDE = 400;

fn scatter(image, count, dx, dy) {
	for (let i = 0; i < count; i++) {
		love_graphics_draw(image, math_random(-16, SIDE) + dx, math_random(-16, SIDE) + dy);
	}
	return 0;
}

# Everything drawn between setCanvas(c) and setCanvas() lands in the canvas
# rather than on the screen.
fn paint_canvas(canvas, image) {
	love_graphics_setCanvas(canvas);
	love_graphics_setBackgroundColor(40, 60, 110);
	love_graphics_clear();

	for (let i = 0; i < COUNT; i++) {
		love_graphics_setColor(math_random(120, 255), math_random(120, 255),
			math_random(180, 255));
		love_graphics_draw(image, math_random(-16, SIDE), math_random(-16, SIDE));
	}

	love_graphics_setColor(255, 255, 255);
	love_graphics_setCanvas();
	return 0;
}

fn love_load() {
	let app = {};
	app.image = love_graphics_newImage("../assets/icon.png");
	app.canvas = love_graphics_newCanvas(SIDE, SIDE);

	paint_canvas(app.canvas, app.image);
	return app;
}

fn love_update(dt, app) {
	if (love_keyboard_isDown("escape")) { love_event_quit(); }
	return 0;
}

fn love_draw(app) {
	love_graphics_setBackgroundColor(26, 28, 36);

	if (love_keyboard_isDown("space")) {
		scatter(app.image, COUNT, 200, 100);
		love_graphics_setColor(255, 180, 120);
		love_graphics_print("drawing all ${COUNT} sprites every frame", 10, 30);
	} else {
		love_graphics_draw(app.canvas, 200, 100);
		love_graphics_setColor(150, 230, 180);
		love_graphics_print("one canvas, drawn once at load", 10, 30);
	}

	let fps = love_timer_getFPS();
	love_graphics_setColor(235, 235, 245);
	love_graphics_print("${fps} fps -- hold SPACE to compare, escape to quit", 10, 10);
	return 0;
}

fn main() {}
