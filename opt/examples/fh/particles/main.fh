# Particle systems.
#
# A system is a texture, a buffer size, and a set of curves that a particle
# follows over its life. Update it with the frame's dt and draw it like any
# other drawable.
#
#   1..5    switch emitter        SPACE  burst 200 particles at the mouse
#   click   move the emitter      escape quit
#
#   cd opt/examples/fh/particles && ../../../../build/clove
#
#   presets.fh   one preset per emitter, each a different corner of the API
#   emitters.fh  them as one thing: switch, move, burst

include "emitters.fh"

fn love_load() {
	let app = {};
	app.emitters = Emitters(love_graphics_newImage("../assets/particle.png"),
		400.0, 400.0);
	return app;
}

fn love_keypressed(key) {
	if (key[0] == "escape") { love_event_quit(); }
	return 0;
}

fn love_update(dt, app) {
	# Polled, not an event: holding a number key should keep that emitter
	# chosen, and holding space should keep bursting.
	for (let i = 0; i < len(app.emitters.all); i++) {
		if (love_keyboard_isDown("" + (i + 1))) { app.emitters.select(i); }
	}

	# The trail emitter chases the mouse; the rest only follow a held button.
	if (app.emitters.current().follows_mouse || love_mouse_isDown("l")) {
		app.emitters.move_to(love_mouse_getX(), love_mouse_getY());
	}

	if (love_keyboard_isDown("space")) { app.emitters.burst(); }
	app.emitters.update(dt);
	return 0;
}

fn love_draw(app) {
	love_graphics_setBackgroundColor(12, 12, 20);
	app.emitters.draw();

	let particles = app.emitters.count();
	let fps = love_timer_getFPS();

	love_graphics_setColor(220, 225, 235);
	love_graphics_print(app.emitters.current().name, 10, 10);
	love_graphics_print("${particles} particles, ${fps} fps", 10, 30);

	love_graphics_setColor(150, 155, 170);
	love_graphics_print("1..5 switch   click move   SPACE burst   escape quit", 10, 560);
	return 0;
}

fn main() {}
