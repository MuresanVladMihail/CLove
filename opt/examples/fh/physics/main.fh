# love.physics example: Box2D through CLove's LOVE-shaped bindings.
#
# A world with a static floor and two walls, a heap of falling boxes and
# circles, and a mouse joint to drag them around with.
#
#   LEFT MOUSE   grab a body, or drop a new one on empty space
#   SPACE        drop a fresh batch
#   ESC          quit
#
#   cd opt/examples/fh/physics && ../../../../build/clove
#
#   world.fh   the world and the bodies in it, each drawn as what it is
#
# The input callbacks are handed no state map, so what they need lives on APP.

include "world.fh"

let WIDTH  = 800;
let HEIGHT = 600;
let BACKGROUND = [24, 26, 32];
let BATCH = 8;

let APP = { "world": null, "contacts": 0 };

# love_world_setCallbacks() takes the *names* of global functions: from C, FH
# can only call a global by name -- which is also why the count lives on APP.
fn on_begin_contact(a, b, contact) {
	APP.contacts = APP.contacts + 1;
	return 0;
}

fn love_load() {
	love_window_setTitle("CLove — love.physics (Box2D)");
	love_graphics_setBackgroundColor(BACKGROUND[0], BACKGROUND[1], BACKGROUND[2]);
	love_graphics_setFont(love_graphics_newFont(14));

	APP.world = World(WIDTH, HEIGHT);
	love_world_setCallbacks(APP.world.world, "on_begin_contact", null);

	APP.world.build_room();
	APP.world.drop_batch(BATCH);
	return APP;
}

fn love_update(dt, app) {
	app.world.update();
	app.world.drag_to(love_mouse_getX(), love_mouse_getY());
	return 0;
}

# One array, [x, y, button] -- not three arguments. Anything under the cursor
# gets grabbed; empty space gets a new ball.
fn love_mousepressed(m) {
	if (!APP.world.grab_at(m[0], m[1])) { APP.world.ball(m[0], m[1], 14); }
	return 0;
}

fn love_mousereleased(m) {
	APP.world.release();
	return 0;
}

# And one array here too, [name, code, isrepeat].
fn love_keypressed(key) {
	if (key[0] == "escape") { love_event_quit(); }
	elif (key[0] == "space") { APP.world.drop_batch(BATCH); }
	return 0;
}

fn love_draw(app) {
	app.world.draw(BACKGROUND);

	let bodies = app.world.count();
	let contacts = app.contacts;
	let fps = love_timer_getFPS();

	love_graphics_setColor(220, 224, 230);
	love_graphics_print("bodies: ${bodies}   contacts so far: ${contacts}" +
		"   fps: ${fps}", 50, 50);
	love_graphics_print("left mouse: grab or drop    space: more    esc: quit", 50, 70);
	return 0;
}

fn main() {}
