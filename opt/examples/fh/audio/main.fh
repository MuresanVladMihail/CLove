# love.audio: a static source, with volume, pitch, looping and pause.
#
# Note where the state lives. love_load()'s return value reaches love_update
# and love_draw, but *not* the input callbacks -- love_keypressed(key) gets
# only the key. Anything a key event has to touch therefore lives in a
# module-level map. A map works where a plain `let` would not: a global
# binding in FH is constant, but the map it points at is not.
#
#   SPACE play        L   toggle looping     UP/DOWN     volume
#   S     stop        P   pause / resume     LEFT/RIGHT  pitch
#   click the bar to seek
#
#   cd opt/examples/fh/audio && ../../../../build/clove
#
#   source.fh  the source and what can be done to it
#   panel.fh   the readout, the bars, and the seek bar's hit test

include "source.fh"
include "panel.fh"

let APP = { "track": null };

fn love_load() {
	APP.track = Track("../assets/tone.wav");
	return APP;
}

# Toggles belong in a key event, not in isDown(): polled every frame, a toggle
# would flip sixty times a second while the key is held.
fn love_keypressed(key) {
	let k = key[0];
	if (k == "escape") { love_event_quit(); }
	elif (k == "space") { APP.track.play(); }
	elif (k == "s") { APP.track.stop(); }
	elif (k == "l") { APP.track.toggle_loop(); }
	elif (k == "p") { APP.track.toggle_pause(); }
	return 0;
}

fn love_mousepressed(m) {
	if (panel_seek_hit(m[0], m[1])) {
		APP.track.seek_fraction(panel_seek_fraction(m[0]));
	}
	return 0;
}

# Held keys, on the other hand, want polling.
fn love_update(dt, app) {
	if (love_keyboard_isDown("up")) { app.track.nudge_volume(dt); }
	if (love_keyboard_isDown("down")) { app.track.nudge_volume(0.0 - dt); }
	if (love_keyboard_isDown("right")) { app.track.nudge_pitch(dt); }
	if (love_keyboard_isDown("left")) { app.track.nudge_pitch(0.0 - dt); }
	return 0;
}

fn love_draw(app) {
	love_graphics_setBackgroundColor(24, 26, 34);
	panel_draw(app.track);
	return 0;
}

fn main() {}
