# ============================================================================
#  A game with the editor built into it
# ----------------------------------------------------------------------------
#  Run it with:
#      cd opt/examples/fh/game && ../../../../build/clove
#
#  Press F1. The editor opens over the running game, on the very level the game
#  is playing -- move a platform, drop in a crate, retint a sprite -- and F1
#  again drops you back into the game with the change already in it. There is
#  no file to save in between and no second window: the level being edited and
#  the level being played are the same document in the same process.
#
#  Two packages do the work:
#
#      packages/editor   the editor itself, switched on and off from here
#      packages/scene    the read side of a level, for building the world --
#                        entities, and the tile map painted under them
#
#  and this example is four files of its own:
#
#      assets.fh   images and quads, loaded once
#      world.fh    the Box2D world built from a scene
#      render.fh   drawing that scene: the map, then the entities
#      level.fh    the level it plays on a first run
#
#  What main.fh is, is the wiring: forward the input callbacks, keep the world
#  in step with the document, and draw.
# ============================================================================

include "packages/editor/editor.fh"
include "packages/scene/scene.fh"

include "assets.fh"
include "world.fh"
include "render.fh"
include "level.fh"

let LEVEL = "level1.json";

# love_quit() and the input callbacks are handed no state map, so the game
# state parks here for them the same way the editor's does.
let HOST = { "game": null };

# Rebuilt from the document whenever the editor has changed it.
fn rebuild(g) {
	g.scene = Scene(editor_document(g.ed));
	g.world = GameWorld(g.scene);
	g.world.build();
	g.renderer.build_tiles(g.scene);
	g.built_at = editor_revision(g.ed);

	println("world rebuilt: " + len(g.world.bodies) + " bodies, " +
		g.world.tile_shapes + " tile shapes, at revision " + g.built_at);
	return 0;
}

fn love_load() {
	let g = {};
	g.renderer = Renderer(Assets());

	# The editor is not standalone here: Esc switches it off rather than
	# quitting, and it starts switched off so the game is what you see first.
	g.ed = editor_new({ "scene": LEVEL, "standalone": false, "active": false });
	if (doc_count(g.ed) == 0) { seed_level(g.ed, LEVEL); }

	rebuild(g);
	love_graphics_setBackgroundColor(24, 26, 32, 255);

	HOST.game = g;
	return g;
}

fn love_update(dt, g) {
	if (editor_active(g.ed)) {
		editor_update(g.ed, dt);
		return 0;
	}

	# Back in the game: if the level moved on while the editor was open, the
	# world is out of date. A host that wanted the change to land mid-edit
	# would do this whenever the revision moves instead -- the revision is
	# there so the choice is the host's.
	if (editor_revision(g.ed) != g.built_at) { rebuild(g); }

	g.world.update(dt);
	return 0;
}

fn love_draw(g) {
	g.renderer.draw(g.scene, g.world);

	love_graphics_setColor(150, 155, 170, 255);
	love_graphics_print("F1: editor", 12, 12);
	love_graphics_setColor(255, 255, 255, 255);

	# Last, so the panels sit over the game rather than under it.
	editor_draw(g.ed);
	return 0;
}


# ============================================================================
#  Input
# ============================================================================
#
#  Forwarded rather than owned by the package: FH has one global namespace, and
#  these are names a game needs for itself.

fn love_keypressed(k) {
	if (k[0] == "f1" && !k[2]) {
		editor_toggle(HOST.game.ed);
		return 0;
	}
	editor_keypressed(k);
	return 0;
}

fn love_mousepressed(m)  { editor_mousepressed(m); }
fn love_mousereleased(m) { editor_mousereleased(m); }
fn love_wheelmoved(y)    { editor_wheelmoved(y); }
fn love_quit()           { return editor_quit(); }

fn main() {}
