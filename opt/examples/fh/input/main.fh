# Keyboard, mouse and joystick -- polling versus events.
#
# The two are not interchangeable:
#
#   * love_keyboard_isDown("left") answers "is it held right now". Right for
#     movement, wrong for a toggle -- polled every frame, a toggle flips sixty
#     times a second while the key is down.
#   * love_keypressed(key) fires once per press. Right for toggles, menus and
#     anything that must not repeat. key[0] is the name, key[1] the keycode,
#     key[2] whether it is an auto-repeat.
#
# The input callbacks do NOT receive love_load's state -- they take only their
# own arguments -- so anything they touch lives in a module-level map.
#
#   move with WASD or the arrows, or a gamepad stick
#   T  trail on/off      escape  quit
#
#   cd opt/examples/fh/input && ../../../../build/clove
#
#   player.fh  the dot, its movement and its trail  (polling)
#   log.fh     the event feed                       (events)
#   hud.fh     the readout on the right

include "log.fh"
include "player.fh"
include "hud.fh"

let FIELD = [14, 62, 620, 424];          # x, y, w, h of the box you move inside
let TEXT_LIMIT = 28;

let APP = {
	"player": null,
	"log": null,
	"sticks": 0,
	"last_key": "-",
	"text": "",
	"wheel": 0,
	"clicks": 0
};

fn love_load() {
	APP.player = Player(320.0, 270.0, [28, 76, 620, 470]);
	APP.log = EventLog(8);
	APP.sticks = love_joystick_getCount();
	return APP;
}

# --- events -----------------------------------------------------------------

fn love_keypressed(key) {
	APP.last_key = key[0];
	if (key[0] == "escape") { love_event_quit(); }

	# A toggle belongs here, not in isDown().
	if (key[0] == "t") { APP.player.toggle_trail(); }

	let again = "";
	if (key[2]) { again = "  (auto-repeat)"; }
	APP.log.add("keypressed  " + key[0] + "  code " + key[1] + again);
	return 0;
}

fn love_keyreleased(key) {
	APP.log.add("keyreleased " + key[0]);
	return 0;
}

# What the OS produced, after keyboard layout and dead keys -- not the same
# thing as a key name. This is what a text field should listen to.
fn love_textinput(text) {
	APP.text = APP.text + text;
	while (len(APP.text) > TEXT_LIMIT) {
		APP.text = string_substr(APP.text, 1, len(APP.text) - 1);
	}
	APP.log.add("textinput   '" + text + "'");
	return 0;
}

fn love_mousepressed(m) {
	APP.clicks++;
	APP.log.add("mousepressed at " + m[0] + ", " + m[1]);
	return 0;
}

fn love_mousereleased(m) {
	APP.log.add("mousereleased");
	return 0;
}

fn love_wheelmoved(y) {
	APP.wheel = APP.wheel + y;
	APP.log.add("wheelmoved " + y);
	return 0;
}

fn love_joystickpressed(j) {
	APP.log.add("joystick " + j[0] + " button " + j[1]);
	return 0;
}

fn love_joystickreleased(j) {
	APP.log.add("joystick " + j[0] + " release " + j[1]);
	return 0;
}

# --- polling ----------------------------------------------------------------

fn love_update(dt, app) {
	app.player.update(dt, app.sticks > 0);
	return 0;
}

fn love_draw(app) {
	love_graphics_setBackgroundColor(22, 24, 32);

	love_graphics_setColor(60, 64, 78);
	love_geometry_rectangle("line", FIELD[0], FIELD[1], FIELD[2], FIELD[3]);

	app.player.draw();
	hud_pointer(app.player);

	love_graphics_setColor(235, 235, 245);
	love_graphics_print("input -- polling and events", 20, 16);
	love_graphics_setColor(150, 155, 170);
	love_graphics_print("WASD / arrows / left stick to move    T trail    escape quit",
		20, 38);

	hud_state(app, app.player);
	hud_joystick(app.sticks);

	love_graphics_setColor(120, 200, 255);
	love_graphics_print("events", 20, 510);
	app.log.draw(20, 534, 18);
	return 0;
}

fn main() {}
