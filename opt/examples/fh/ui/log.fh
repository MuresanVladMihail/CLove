# The log window's content: the lines, the panel they scroll in, and the box
# you type a new one into.
#
# It owns its microui container and its text-box id, because both are part of
# "the log" rather than of the program around it.

let LOG_BOX = 1;          # a text box's id, see the note in main.fh
let LOG_LIMIT = 60;
let LOG_TRIM = 10;        # dropped in one go, so trimming is rare

fn Log() {
	let self = { "lines": [], "panel": love_ui_newContainer() };

	self.add = fn(line) {
		append(self.lines, line);
		if (len(self.lines) <= LOG_LIMIT) { return 0; }

		let kept = [];
		for (let i = LOG_TRIM; i < len(self.lines); i++) { append(kept, self.lines[i]); }
		self.lines = kept;
		return 0;
	};

	self.draw_lines = fn() {
		love_ui_layout_row(1, [-1], -30);
		love_ui_begin_panel(self.panel, "log", 0);
		love_ui_layout_row(1, [-1], 0);
		for (let i = 0; i < len(self.lines); i++) { love_ui_text(self.lines[i]); }
		love_ui_end_panel();
		return 0;
	};

	# love_ui_textbox(id) -> [res, text]; microui owns the buffer, so what you
	# type survives between frames and is cleared explicitly.
	self.draw_entry = fn() {
		love_ui_layout_row(2, [-70, -1], 0);
		let box = love_ui_textbox(LOG_BOX);

		let submitted = box[0] == love_ui_res_state("submit");
		if (love_ui_button("Submit", ALIGN_CENTER)) { submitted = true; }

		if (submitted && len(box[1]) > 0) {
			self.add(box[1]);
			love_ui_clear_textbox(LOG_BOX);
		}
		return 0;
	};

	return self;
}
