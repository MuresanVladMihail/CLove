# ============================================================================
#  CLove UI example -- the microui widget set
# ----------------------------------------------------------------------------
#  Run it with:
#      cd opt/examples/fh/ui && ../../../../build/clove
#
#      log.fh      the log window's lines, panel and entry box
#      windows.fh  one function per window
#
#  For a larger, application-shaped use of the same widgets (docked panels, a
#  viewport, an inspector), see ../editor.
# ============================================================================

# love_ui_opt() and love_ui_align() name some of microui's MU_OPT_* flags; the
# rest are plain bit values from src/3rdparty/microui/src/microui.h.
let ALIGN_CENTER = 1;
let OPT_EXPANDED = 4096;   # MU_OPT_EXPANDED -- headers and trees start open

include "windows.fh"

fn love_load() {
	let app = {};
	app.log = Log();
	app.checks = [true, false, false];
	app.bg = [90, 95, 110];

	app.log.add("ui example started");
	love_graphics_setBackgroundColor(app.bg[0], app.bg[1], app.bg[2], 255);
	return app;
}

# The whole UI is rebuilt every frame between love_ui_begin() and end(): that
# is what "immediate mode" means, and it is why a widget's state lives in the
# script rather than in a retained widget object.
fn love_update(dt, app) {
	if (love_keyboard_isDown("escape")) { love_event_quit(); }

	love_ui_begin();
	window_demo(app);
	window_log(app);
	window_style(app);
	love_ui_end();
	return 0;
}

fn love_draw(app) {
	love_graphics_setBackgroundColor(app.bg[0], app.bg[1], app.bg[2], 255);
	return 0;
}

fn main() {}
