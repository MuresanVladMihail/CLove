# love.math: simplex noise, and the convexity test.
#
# love_math_noise(x [, y [, z [, w]]]) is simplex noise in one to four
# dimensions, in roughly -1..1. Feeding it a coordinate grid gives a texture;
# feeding it time as an extra dimension animates it without any state.
#
#   1  1D: a rolling curve       3  2D animated (time as the third axis)
#   2  2D: a height field        4  octaves: noise summed at several scales
#
#   UP/DOWN  scale      LEFT/RIGHT  speed      escape  quit
#
#   cd opt/examples/fh/noise && ../../../../build/clove
#
#   field.fh  the noise field and the canvas it is painted into
#   shape.fh  the draggable polygon behind love_math_isConvex

include "field.fh"
include "shape.fh"

let APP = { "field": null, "shape": null };

fn love_load() {
	APP.field = NoiseField();
	APP.shape = ConvexShape([560, 420,  700, 400,  760, 500,  620, 540]);
	return APP;
}

fn love_keypressed(key) {
	let k = key[0];
	if (k == "escape") { love_event_quit(); }

	for (let mode = 0; mode < len(MODE_NAMES); mode++) {
		if (k == "" + (mode + 1)) { APP.field.set_mode(mode); }
	}
	return 0;
}

fn love_mousepressed(m) {
	APP.shape.grab_at(m[0], m[1]);
	return 0;
}

fn love_mousereleased(m) {
	APP.shape.release();
	return 0;
}

fn love_update(dt, app) {
	# Held keys, so the scale and the speed slide rather than step.
	if (love_keyboard_isDown("up")) { app.field.zoom(1.0 + dt); }
	if (love_keyboard_isDown("down")) { app.field.zoom(1.0 / (1.0 + dt)); }
	if (love_keyboard_isDown("right")) { app.field.speed = app.field.speed + dt; }
	if (love_keyboard_isDown("left")) { app.field.speed = app.field.speed - dt; }

	if (love_mouse_isDown("l")) {
		app.shape.drag_to(love_mouse_getX(), love_mouse_getY());
	}

	app.field.update(dt);
	return 0;
}

fn love_draw(app) {
	love_graphics_setBackgroundColor(22, 24, 32);
	app.field.draw(20, 60);

	love_graphics_setColor(235, 235, 245);
	love_graphics_print("love.math -- simplex noise", 20, 16);
	love_graphics_setColor(200, 205, 215);
	love_graphics_print(app.field.name(), 20, 36);

	let scale = app.field.scale;
	let speed = app.field.speed;

	love_graphics_setColor(150, 155, 170);
	love_graphics_print("scale ${scale}", 20, 434);
	love_graphics_print("speed ${speed}", 200, 434);
	love_graphics_print("1..4 mode   UP/DOWN scale   LEFT/RIGHT speed   escape quit",
		20, 458);

	love_graphics_setColor(235, 235, 245);
	love_graphics_print("love_math_isConvex -- drag a corner", 540, 380);
	app.shape.draw();
	love_graphics_print(app.shape.verdict(), 540, 560);
	return 0;
}

fn main() {}
