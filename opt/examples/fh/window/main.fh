# love.window: the window itself, and reacting when it changes.
#
# config.fh sets the window up before it opens (see the `config` example);
# love.window changes it afterwards. The one thing that is easy to miss is
# love_resize(w, h) -- the engine calls it whenever the window changes size,
# and a game that lays anything out has to listen.
#
#   F  fullscreen (desktop)     B  borderless
#   1/2/3  720x480 / 960x600 / 1280x720
#   T  retitle      V  vsync      C  centre on screen
#   escape  quit
#
#   cd opt/examples/fh/window && ../../../../build/clove
#
#   window_state.fh  what the window is, and the calls that change it
#   log.fh           the event feed
#   readout.fh       the frame and the table

include "log.fh"
include "window_state.fh"
include "readout.fh"

let APP = { "window": null, "log": null };

fn love_load() {
	APP.window = WindowState("CLove -- love.window");
	APP.log = EventLog(10);
	APP.log.add("started at " + love_window_getWidth() + "x" + love_window_getHeight());
	return APP;
}

# The engine calls this on every size change -- dragging the corner included.
fn love_resize(w, h) {
	APP.window.resizes++;
	APP.log.add("resized to " + w + "x" + h);
	return 0;
}

# Both of these come off the SDL window event, the way LOVE dispatches
# love.focus and love.mousefocus -- not from polling every frame.
fn love_focus(focused) {
	APP.window.focus = focused;
	APP.log.add("love_focus " + focused);
	return 0;
}

fn love_mousefocus(focused) {
	APP.window.mouse_focus = focused;
	APP.log.add("love_mousefocus " + focused);
	return 0;
}

fn love_keypressed(key) {
	let k = key[0];
	let window = APP.window;

	if (k == "escape") { love_event_quit(); }
	elif (k == "f") { APP.log.add(window.toggle_fullscreen()); }
	elif (k == "b") { APP.log.add(window.toggle_borderless()); }
	elif (k == "v") { APP.log.add(window.toggle_vsync()); }
	elif (k == "t") { APP.log.add(window.retitle()); }
	elif (k == "c") { APP.log.add(window.centre()); }
	elif (k == "1") { APP.log.add(window.resize(720, 480)); }
	elif (k == "2") { APP.log.add(window.resize(960, 600)); }
	elif (k == "3") { APP.log.add(window.resize(1280, 720)); }
	return 0;
}

fn love_draw(app) {
	love_graphics_setBackgroundColor(24, 26, 34);

	let w = love_window_getWidth();
	let h = love_window_getHeight();

	readout_frame(w, h);
	love_graphics_setColor(235, 235, 245);
	love_graphics_print("love.window", 30, 34);
	readout_table(app.window);
	app.log.draw(30, 330, 20);

	love_graphics_setColor(150, 155, 170);
	love_graphics_print("F fullscreen   B borderless   V vsync   T retitle   C centre",
		30, h - 54);
	love_graphics_print("1/2/3 resize   drag the corner   escape quit", 30, h - 34);
	return 0;
}

fn main() {}
