# Drawing an image: position, rotation, scale, origin and shear.
#
# love_graphics_draw(image, x, y, r, sx, sy, ox, oy, kx, ky) -- every argument
# after the image is optional, and they mean the same thing they do in LOVE.
#
#   cd opt/examples/fh/draw_image && ../../../../build/clove

# The sprite is 58x50, drawn at 2x, in a grid of 190x230 cells -- so no cell
# can spill into its neighbour's label, not even while spinning.
let CELL_W = 190;
let CELL_H = 230;
let ORIGIN_X = 30;
let ORIGIN_Y = 60;

fn label(text, x, y) {
	love_graphics_setColor(200, 205, 215);
	love_graphics_print(text, x, y);
	love_graphics_setColor(255, 255, 255);
	return 0;
}

fn cell_x(column) { return ORIGIN_X + column * CELL_W; }
fn cell_y(row) { return ORIGIN_Y + row * CELL_H; }

# Rotation happens around the origin (ox, oy) given to draw. Hand it the
# image's centre and the sprite spins in place; leave it at 0,0 and the sprite
# swings around its own top-left corner.
fn draw_transforms(app) {
	let y = cell_y(0);

	label("plain", cell_x(0), y);
	love_graphics_draw(app.image, cell_x(0), y + 30);

	label("scaled 2x", cell_x(1), y);
	love_graphics_draw(app.image, cell_x(1), y + 30, 0, 2, 2);

	label("spun about its centre", cell_x(2), y);
	love_graphics_draw(app.image, cell_x(2) + 60, y + 90, app.t, 2, 2,
		app.w * 0.5, app.h * 0.5);

	label("spun about its corner", cell_x(3), y);
	love_graphics_draw(app.image, cell_x(3) + 30, y + 60, app.t, 2, 2);
	return 0;
}

fn draw_effects(app) {
	let y = cell_y(1);

	label("sheared", cell_x(0), y);
	love_graphics_draw(app.image, cell_x(0), y + 30, 0, 2, 2, 0, 0, 0.4, 0.0);

	label("tinted", cell_x(1), y);
	love_graphics_setColor(255, 120, 90);
	love_graphics_draw(app.image, cell_x(1), y + 30, 0, 2, 2);
	love_graphics_setColor(255, 255, 255);

	label("flipped: a negative scale", cell_x(2), y);
	love_graphics_draw(app.image, cell_x(2) + 120, y + 30, 0, -2, 2);

	label("a quad: top-left quarter", cell_x(3), y);
	love_graphics_draw(app.image, app.quad, cell_x(3), y + 30, 0, 4, 4);
	return 0;
}

fn love_load() {
	let app = {};
	app.image = love_graphics_newImage("../assets/sprite.png");
	app.w = love_image_getWidth(app.image);
	app.h = love_image_getHeight(app.image);
	app.t = 0.0;

	# A quad is a sub-rectangle of the image, in pixels, with the image's own
	# size as the reference -- the top-left quarter here.
	app.quad = love_graphics_newQuad(0, 0, app.w / 2, app.h / 2, app.w, app.h);

	# The window icon can be any loaded image.
	love_window_setIcon(app.image);
	return app;
}

fn love_update(dt, app) {
	app.t = app.t + dt;
	if (love_keyboard_isDown("escape")) { love_event_quit(); }
	return 0;
}

fn love_draw(app) {
	love_graphics_setBackgroundColor(28, 30, 38);

	draw_transforms(app);
	draw_effects(app);

	let fps = love_timer_getFPS();
	love_graphics_setColor(200, 205, 215);
	love_graphics_print("${fps} fps -- escape to quit", 10, 10);
	return 0;
}

fn main() {}
