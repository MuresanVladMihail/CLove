# Drawing an image: position, rotation, scale, origin and shear.
#
# love_graphics_draw(image, x, y, r, sx, sy, ox, oy, kx, ky) -- every argument
# after the image is optional, and they mean the same thing they do in LOVE.
#
#   cd opt/examples/fh/draw_image && ../../../../build/clove

fn love_load() {
    let self = {};
    self.img = love_graphics_newImage("../assets/sprite.png");
    self.w = love_image_getWidth(self.img);
    self.h = love_image_getHeight(self.img);
    self.t = 0.0;

    # A quad is a sub-rectangle of the image, in pixels, with the image's own
    # size as the reference -- the top-left quarter here.
    self.quad = love_graphics_newQuad(0, 0, self.w / 2, self.h / 2, self.w, self.h);

    # The window icon can be any loaded image.
    love_window_setIcon(self.img);
    return self;
}

fn love_update(dt, self) {
    self.t = self.t + dt;
    if (love_keyboard_isDown("escape")) { love_event_quit(); }
}

fn label(text, x, y) {
    love_graphics_setColor(200, 205, 215);
    love_graphics_print(text, x, y);
    love_graphics_setColor(255, 255, 255);
}

fn love_draw(self) {
    love_graphics_setBackgroundColor(28, 30, 38);

    # The sprite is 58x50, drawn at 2x, in a grid of 190x230 cells -- so no
    # cell can spill into its neighbour's label, not even while spinning.
    let cw = 190;
    let ch = 230;
    let ox = 30;
    let oy = 60;

    label("plain", ox, oy);
    love_graphics_draw(self.img, ox, oy + 30);

    label("scaled 2x", ox + cw, oy);
    love_graphics_draw(self.img, ox + cw, oy + 30, 0, 2, 2);

    # Rotation happens around the origin (ox, oy) given to draw. Hand it the
    # image's centre and the sprite spins in place; leave it at 0,0 and the
    # sprite swings around its own top-left corner.
    label("spun about its centre", ox + 2 * cw, oy);
    love_graphics_draw(self.img, ox + 2 * cw + 60, oy + 90, self.t, 2, 2, self.w / 2, self.h / 2);

    label("spun about its corner", ox + 3 * cw, oy);
    love_graphics_draw(self.img, ox + 3 * cw + 30, oy + 60, self.t, 2, 2);

    label("sheared", ox, oy + ch);
    love_graphics_draw(self.img, ox, oy + ch + 30, 0, 2, 2, 0, 0, 0.4, 0.0);

    label("tinted", ox + cw, oy + ch);
    love_graphics_setColor(255, 120, 90);
    love_graphics_draw(self.img, ox + cw, oy + ch + 30, 0, 2, 2);
    love_graphics_setColor(255, 255, 255);

    label("flipped: a negative scale", ox + 2 * cw, oy + ch);
    love_graphics_draw(self.img, ox + 2 * cw + 120, oy + ch + 30, 0, -2, 2);

    label("a quad: top-left quarter", ox + 3 * cw, oy + ch);
    love_graphics_draw(self.img, self.quad, ox + 3 * cw, oy + ch + 30, 0, 4, 4);

    love_graphics_setColor(200, 205, 215);
    love_graphics_print("" + love_timer_getFPS() + " fps -- escape to quit", 10, 10);
}

fn main() {}
