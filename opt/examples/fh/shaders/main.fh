# Shaders: GLSL through LOVE's shape.
#
# Either half of a shader may be left out -- a fragment shader on its own gets
# the default pass-through vertex stage -- and either may be a path to a file
# instead of the source itself.
#
#   1  mix two textures      3  a wave, driven by time
#   2  greyscale             4  no shader
#
#   cd opt/examples/fh/shaders && ../../../../build/clove
#
#   effects.fh  the shaders themselves

include "effects.fh"

fn love_load() {
	let app = {};
	app.sprite = love_graphics_newImage("../assets/sprite.png");
	app.effects = Effects(love_graphics_newImage("../assets/icon.png"));

	println("Maximum textures per shader: ", love_graphics_getMaxTextureUnits());
	return app;
}

fn love_keypressed(key) {
	if (key[0] == "escape") { love_event_quit(); }
	return 0;
}

fn love_update(dt, app) {
	for (let i = 0; i < len(app.effects.all); i++) {
		if (love_keyboard_isDown("" + (i + 1))) { app.effects.select(i); }
	}
	app.effects.update(dt);
	return 0;
}

fn love_draw(app) {
	love_graphics_setBackgroundColor(26, 28, 36);
	love_graphics_setColor(255, 255, 255);

	app.effects.bind();
	love_graphics_draw(app.sprite, 120, 180, 0, 5, 5);

	# Anything drawn after setShader(null) uses the default one again -- the
	# same sprite on the right, for comparison.
	love_graphics_setShader(null);
	love_graphics_draw(app.sprite, 500, 180, 0, 5, 5);

	love_graphics_setColor(200, 205, 215);
	love_graphics_print(app.effects.current().name, 10, 10);
	love_graphics_print("left: the shader     right: no shader", 10, 30);
	let fps = love_timer_getFPS();
	love_graphics_print("${fps} fps -- 1..4 switch, escape to quit", 10, 50);
	return 0;
}

fn main() {}
