fn love_config(c) {
	c.window_title = "CLove — 2D Editor Skeleton (microui)";
	c.window_width = 1280;
	c.window_height = 760;
	c.window_x = -1;
	c.window_y = -1;
	c.window_vsync = true;

	# The panels are docks, laid out from the window size every frame and
	# re-placed with love_ui_setWindowRect() -- microui applies the rect passed
	# to love_ui_begin_window() only the first time it sees a window, which is
	# what used to pin them to whatever size the editor started at. So the
	# window can be resized now, and they follow it.
	c.window_resizable = true;
}
