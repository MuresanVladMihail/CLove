# ============================================================================
#  The 2D editor, on its own
# ----------------------------------------------------------------------------
#  Run it with:
#      cd opt/examples/fh/editor && ../../../../build/clove
#
#  All of the editor is in opt/packages/editor; this file is only the host that
#  gives it a program to live in. The other host is a game -- see
#  opt/examples/fh/game, which switches the same editor on and off with F1 and
#  keeps playing the level it edits.
#
#  What is left here is the demo scene, because a starting crate, a coin and a
#  painted ledge belong to the example rather than to the editor: a game
#  embedding the editor has its own level and would not thank anyone for these.
# ============================================================================

include "packages/editor/editor.fh"


let HOST = { "ed": null };

fn love_load() {
	love_graphics_setBackgroundColor(30, 32, 38, 255);

	# standalone: the editor is the program, so it starts switched on and Esc
	# quits rather than switching it off
	let ed = editor_new({ "standalone": true });
	HOST.ed = ed;

	# A scene to look at on a first run, when there is no file on disk yet.
	# Ground has no artwork, so its colour is the fill. The two that carry a
	# sprite start white: the colour modulates the sprite, and white is what
	# "no tint" looks like.
	if (doc_count(ed) == 0) {
		let ground = doc_add(ed, "Ground", "rect",   140, 560, 700,  90,  92, 128,  84);
		let crate  = doc_add(ed, "Crate",  "rect",   300, 300,  90,  90, 255, 255, 255);
		let coin   = doc_add(ed, "Coin",   "circle", 520, 200,  56,  56, 255, 255, 255);

		ground.groups = ["terrain"];
		crate.groups = ["props", "breakable"];
		coin.groups = ["pickups"];

		crate.sprite = { "path": "art/crate.svg" };
		crate.body.type = "dynamic";
		coin.sprite = { "path": "art/coin.svg" };
		coin.body.type = "dynamic";
		coin.fixtures[0].restitution = 0.6;

		# A spritesheet and a few cells painted from it, so the map side of
		# the editor is on screen rather than only in the README. Press Tiles
		# and the sheet opens on the right: click a tile, click the scene.
		let sheet = tiles_add_set(ed, "art/tiles.png");
		let map = tiles_map(ed);
		map.tile_w = 32;
		map.tile_h = 32;

		let layer = tiles_current_layer(ed);
		layer.solid = true;            # so Play collides with it
		for (let cx = 16; cx < 24; cx++) {
			tiles_put(ed, layer, cx, 12, [sheet.id, 0, 0]);
			tiles_put(ed, layer, cx, 13, [sheet.id, 1, 0]);
		}
		ed.brush = [sheet.id, 0, 0];

		ed.selected_id = 2;
		log_line(ed, doc_count(ed) + " entities, " + tiles_count(ed) +
			" tiles (unsaved, " + ed.scene_path + ")");
	}
	return ed;
}

fn love_update(dt, ed) { editor_update(ed, dt); }
fn love_draw(ed)       { editor_draw(ed); }

# CLove hands the input callbacks no state map, so the package parks each event
# until the next editor_update() picks it up. Forwarding them is the host's job:
# FH has one global namespace, and a game needs these names for its own input.
fn love_mousepressed(m)  { editor_mousepressed(m); }
fn love_mousereleased(m) { editor_mousereleased(m); }
fn love_keypressed(k)    { editor_keypressed(k); }
fn love_wheelmoved(y)    { editor_wheelmoved(y); }
fn love_quit()           { return editor_quit(); }

fn main() {}
