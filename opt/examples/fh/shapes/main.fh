# love.geometry: the immediate-mode shapes.
#
# Every call takes "fill" or "line" as its first argument. Circles take an
# optional segment count, and love_geometry_polygon draws a polygon (filled) or
# a polyline (line) from a flat x,y array.
#
#   cd opt/examples/fh/shapes && ../../../../build/clove

fn label(text, x, y) {
	love_graphics_setColor(190, 195, 205);
	love_graphics_print(text, x, y);
	return 0;
}

# Few segments turns a circle into a regular polygon -- the segment count is
# the whole difference between a disc and a hexagon.
fn draw_circles() {
	label("circles", 60, 60);

	love_graphics_setColor(120, 200, 255);
	love_geometry_circle("line", 90, 130, 34);
	love_geometry_circle("fill", 180, 130, 34);

	love_graphics_setColor(255, 190, 100);
	love_geometry_circle("fill", 270, 130, 34, 6);
	love_geometry_circle("line", 360, 130, 34, 3);
	return 0;
}

fn draw_rectangles(t) {
	label("rectangles -- the last argument is a rotation", 60, 220);

	love_graphics_setColor(150, 230, 160);
	love_geometry_rectangle("line", 70, 250, 60, 60);
	love_geometry_rectangle("fill", 160, 250, 60, 60);
	love_geometry_rectangle("fill", 280, 280, 60, 60, t);
	return 0;
}

fn draw_points(t) {
	label("points -- one flat x,y array, not one call per point", 60, 380);

	love_graphics_setColor(255, 255, 255);
	let points = [];
	for (let i = 0; i < 24; i++) {
		append(points, 70 + i * 8);
		append(points, 410 + 18 * math_sin(t + i * 0.4));
	}
	love_geometry_points(points);
	return 0;
}

fn draw_polygons() {
	label("polygons from a flat x,y array", 460, 60);

	love_graphics_setColor(200, 150, 255);
	love_geometry_polygon("fill", [480, 90, 620, 90, 550, 200]);

	# A polyline has to repeat its first point to close.
	love_graphics_setColor(255, 140, 170);
	love_geometry_polygon("line", [480, 240, 700, 240, 760, 400, 460, 400, 480, 240]);
	return 0;
}

fn love_load() {
	return { "t": 0.0 };
}

fn love_update(dt, app) {
	app.t = app.t + dt;
	if (love_keyboard_isDown("escape")) { love_event_quit(); }
	return 0;
}

fn love_draw(app) {
	love_graphics_setBackgroundColor(26, 28, 36);

	draw_circles();
	draw_rectangles(app.t);
	draw_points(app.t);
	draw_polygons();

	let fps = love_timer_getFPS();
	love_graphics_setColor(230, 230, 240);
	love_graphics_print("${fps} fps -- escape to quit", 10, 10);
	return 0;
}

fn main() {}
