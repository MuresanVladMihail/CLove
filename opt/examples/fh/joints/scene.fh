# The world everything is built into: bodies, joints, labels, and the mouse
# joint that drags things about.
#
# It knows nothing about which joints the demo shows -- rigs.fh does -- so this
# is the part a game would keep.

include "body.fh"

let GRAB_RADIUS2 = 2500;   # 50 pixels, squared: picking compares, never measures

fn Scene(gravity_y) {
	let self = {};
	self.world = love_physics_newWorld(0, gravity_y);
	self.bodies = [];
	self.joints = [];
	self.labels = [];
	self.grab = null;
	self.direction = 1.0;    # flipped by the motors' reverse

	self.box = fn(x, y, w, h, kind, density) {
		let b = Box(self.world, x, y, w, h, kind, density);
		append(self.bodies, b);
		return b;
	};

	self.ball = fn(x, y, r, kind, density) {
		let b = Ball(self.world, x, y, r, kind, density);
		append(self.bodies, b);
		return b;
	};

	self.joint = fn(j) {
		append(self.joints, j);
		return j;
	};

	self.label = fn(text, x, y) {
		append(self.labels, [text, x, y]);
		return 0;
	};

	# --- dragging ---------------------------------------------------------
	#
	# A mouse joint pulls a body toward a point rather than teleporting it, so
	# whatever it is attached to still collides on the way.

	self.grab_at = fn(x, y) {
		for (let i = 0; i < len(self.bodies); i++) {
			let b = self.bodies[i];
			if (!b.is_dynamic() || b.distance2(x, y) >= GRAB_RADIUS2) { continue; }

			self.grab = love_physics_newMouseJoint(b.body, x, y);
			love_mousejoint_setMaxForce(self.grab, 6000);
			return true;
		}
		return false;
	};

	self.drag_to = fn(x, y) {
		if (self.grab != null) { love_mousejoint_setTarget(self.grab, x, y); }
		return 0;
	};

	self.release = fn() {
		if (self.grab == null) { return 0; }
		love_joint_destroy(self.grab);
		self.grab = null;
		return 0;
	};

	# Every motor at once, each in the units its own joint speaks: an angular
	# speed for the hinges, a linear one for the slider.
	self.reverse_motors = fn() {
		self.direction = 0.0 - self.direction;

		for (let i = 0; i < len(self.joints); i++) {
			let j = self.joints[i];
			let kind = love_joint_getType(j);
			if (kind == "revolute") {
				love_revolutejoint_setMotorSpeed(j, 3.0 * self.direction);
			} elif (kind == "prismatic") {
				love_prismaticjoint_setMotorSpeed(j, 80.0 * self.direction);
			} elif (kind == "wheel") {
				love_wheeljoint_setMotorSpeed(j, -6.0 * self.direction);
			}
		}
		return 0;
	};

	self.update = fn(dt) {
		love_world_update(self.world, dt);
		return 0;
	};

	# --- drawing ----------------------------------------------------------

	self.draw_bodies = fn() {
		for (let i = 0; i < len(self.bodies); i++) { self.bodies[i].draw(); }
		return 0;
	};

	# A joint drawn as the line between its two anchors, with a dot at each:
	# that is what a joint *is*, whatever else it does to the bodies.
	self.draw_joints = fn() {
		love_graphics_setColor(255, 190, 90);
		for (let i = 0; i < len(self.joints); i++) {
			let p = love_joint_getAnchors(self.joints[i]);
			love_geometry_polygon("line", [p[0], p[1], p[2], p[3]]);
			love_geometry_circle("fill", p[0], p[1], 3);
			love_geometry_circle("fill", p[2], p[3], 3);
		}
		return 0;
	};

	self.draw_labels = fn() {
		love_graphics_setColor(200, 205, 218);
		for (let i = 0; i < len(self.labels); i++) {
			let l = self.labels[i];
			love_graphics_print(l[0], l[1], l[2]);
		}
		return 0;
	};

	return self;
}
