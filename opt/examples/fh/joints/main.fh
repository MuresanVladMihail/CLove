# love.physics joints: every kind CLove has, in one world.
#
# The `physics` example covers worlds, bodies, fixtures and a mouse joint.
# This one is about the other eight, each doing the thing it is for:
#
#   revolute   a hinge, with a motor and angle limits   -- the wheel of a mill
#   prismatic  a slider along one axis, with a motor    -- a lift platform
#   wheel      a hinge on a spring                       -- car suspension
#   distance   a spring between two points               -- a bungee
#   rope       a hard maximum distance                   -- a chain
#   weld       glues two bodies rigidly                  -- a breakable crate
#   friction   drags a body toward rest                  -- ice vs mud
#   motor      drives one body to an offset from another -- a follower
#
#   LEFT MOUSE  drag anything      SPACE  reverse the motors
#   R  reset the scene             J  draw the joints on/off
#   escape  quit
#
#   cd opt/examples/fh/joints && ../../../../build/clove
#
#   body.fh   a body and the shape it is drawn as
#   scene.fh  the world: bodies, joints, labels, and dragging
#   rigs.fh   one rig per joint kind
#
# The input callbacks are handed no state, so the scene lives here for them to
# reach -- the same reason every other example keeps one.

include "rigs.fh"

let APP = { "scene": null, "show_joints": true };

fn love_load() {
	APP.scene = build_scene();
	return APP;
}

fn love_update(dt, app) {
	app.scene.drag_to(love_mouse_getX(), love_mouse_getY());
	app.scene.update(dt);
	return 0;
}

fn love_keypressed(key) {
	let k = key[0];
	if (k == "escape") { love_event_quit(); }
	elif (k == "r") { APP.scene = build_scene(); }
	elif (k == "j") { APP.show_joints = !APP.show_joints; }
	elif (k == "space") { APP.scene.reverse_motors(); }
	return 0;
}

fn love_mousepressed(m) {
	APP.scene.grab_at(love_mouse_getX(), love_mouse_getY());
	return 0;
}

fn love_mousereleased(m) {
	APP.scene.release();
	return 0;
}

fn draw_hud(app) {
	love_graphics_setColor(235, 235, 245);
	love_graphics_print("love.physics -- every joint kind CLove has", 20, 16);

	love_graphics_setColor(150, 155, 170);
	love_graphics_print("drag with the mouse    SPACE reverse motors    R reset    " +
		"J joints    escape quit", 20, 36);
	love_graphics_print(len(app.scene.joints) + " joints, " +
		len(app.scene.bodies) + " bodies, " + love_timer_getFPS() + " fps", 20, 660);
	return 0;
}

fn love_draw(app) {
	love_graphics_setBackgroundColor(20, 22, 30);

	app.scene.draw_bodies();
	if (app.show_joints) { app.scene.draw_joints(); }
	app.scene.draw_labels();
	draw_hud(app);
	return 0;
}

fn main() {}
