# Sprite batches: one draw call for many copies of the same image.
#
# Drawing 150 000 sprites one at a time is 150 000 draw calls. A batch packs
# them all into one vertex buffer and hands the GPU a single one.
#
#   1  fill once, draw every frame     3  no batch: one draw call each
#   2  refill every frame              +/-  more or fewer sprites
#   escape  quit
#
#   cd opt/examples/fh/batch && ../../../../build/clove
#
#   confetti.fh  the sprites, and the three ways of drawing them

include "confetti.fh"

let APP = { "confetti": null };

fn love_load() {
	APP.confetti = Confetti("../assets/icon.png");
	APP.confetti.fill();
	return APP;
}

fn love_keypressed(key) {
	let k = key[0];
	if (k == "escape") { love_event_quit(); }
	elif (k == "1") { APP.confetti.set_mode(MODE_ONCE); }
	elif (k == "2") { APP.confetti.set_mode(MODE_REFILL); }
	elif (k == "3") { APP.confetti.set_mode(MODE_UNBATCHED); }
	elif (k == "=" || k == "+") { APP.confetti.scale_count(2); }
	elif (k == "-") { APP.confetti.scale_count(0.5); }
	return 0;
}

fn love_resize(w, h) {
	APP.confetti.invalidate();
	return 0;
}

fn love_update(dt, app) {
	app.confetti.update();
	return 0;
}

fn draw_readout(app) {
	# a readable panel over the confetti
	love_graphics_setColor(10, 12, 18, 220);
	love_geometry_rectangle("fill", 10, 10, 640, 118);

	love_graphics_setColor(235, 235, 245);
	love_graphics_print(app.confetti.name(), 22, 22);

	let sprites = app.confetti.drawn_count();
	let fps = love_timer_getFPS();
	let once = app.confetti.samples[MODE_ONCE];
	let refilled = app.confetti.samples[MODE_REFILL];
	let unbatched = app.confetti.samples[MODE_UNBATCHED];

	love_graphics_setColor(200, 205, 218);
	love_graphics_print("${sprites} sprites    ${fps} fps", 22, 46);

	love_graphics_setColor(150, 155, 170);
	love_graphics_print("last seen:  batched-once ${once}    refilled ${refilled}" +
		"    unbatched ${unbatched}", 22, 74);
	love_graphics_print("1/2/3 mode    +/- count    escape quit", 22, 98);
	return 0;
}

fn love_draw(app) {
	love_graphics_setBackgroundColor(18, 20, 28);
	app.confetti.draw();
	draw_readout(app);
	return 0;
}

fn main() {}
