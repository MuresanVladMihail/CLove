# love_font_getWrap(): break a string to a width, at spaces where it can.
#
# The old implementation broke wherever the pixel limit fell, mid-word;
# truncated every codepoint to one byte, so non-ASCII text came out mangled;
# and grew its buffer against the *input* length while writing up to two
# bytes per step, then wrote the terminator past every check. The caller's
# malloc(strlen(line)) could not even hold an unwrapped copy.

fn check(cond, msg) { if (!cond) { error(msg); } }

fn test_breaks_on_spaces() {
    let f = love_graphics_newFont("assets/vera.ttf", 20);
    let r = love_font_getWrap(f, "the quick brown fox jumps over the lazy dog", 120);

    check(r[1] > 1, "it should have wrapped at all");

    # Every line must be a whole number of words: no line may start or end
    # mid-word, which is what breaking at spaces guarantees.
    let lines = string_split(r[0], "\n");
    check(len(lines) == r[1], "the reported line count should match the text");

    # Re-joining on single spaces has to give the original back: no character
    # is lost, added, or moved across a word boundary.
    let back = lines[0];
    for (let i = 1; i < len(lines); i++) { back = back + " " + lines[i]; }
    check(back == "the quick brown fox jumps over the lazy dog",
          "wrapping must not lose or add characters");
}

fn test_long_word() {
    let f = love_graphics_newFont("assets/vera.ttf", 20);
    # One word with no space in it still has to break somewhere.
    let r = love_font_getWrap(f, "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa", 80);
    check(r[1] > 1, "a word wider than the limit still breaks");
}

fn test_explicit_newline() {
    let f = love_graphics_newFont("assets/vera.ttf", 20);
    let r = love_font_getWrap(f, "one\ntwo\nthree", 10000);
    check(r[1] == 3, "newlines in the input count as line breaks");
}

fn test_exact_fit() {
    # The overflow case: an input that needs no wrapping at all still has to
    # fit its terminator, and malloc(strlen(line)) did not leave room.
    let f = love_graphics_newFont("assets/vera.ttf", 20);
    let r = love_font_getWrap(f, "short", 100000);
    check(r[0] == "short", "text under the limit comes back unchanged");
    check(r[1] == 1, "and on one line");
}

fn test_empty() {
    let f = love_graphics_newFont("assets/vera.ttf", 20);
    let r = love_font_getWrap(f, "", 100);
    check(r[0] == "", "an empty string wraps to an empty string");
    check(r[1] == 1, "which is one line");
}

fn test_utf8() {
    let f = love_graphics_newFont("assets/vera.ttf", 20);
    # Each codepoint used to be written back as a single char.
    let r = love_font_getWrap(f, "ăîșță", 100000);
    check(r[0] == "ăîșță", "multi-byte characters survive the round trip");
}

fn test_bitmap_font() {
    let bf = love_graphics_newBitmapFont("assets/bitmapfont.png", " abcd\n", 9);
    let r = love_font_getWrap(bf, "abcd dcba abcd dcba", 40);
    check(r[1] > 1, "a bitmap font wraps too");
    check(len(r[0]) > 0, "and returns text -- an empty result used to be a null deref");
}

fn run() {
    test_breaks_on_spaces();
    test_long_word();
    test_explicit_newline();
    test_exact_fit();
    test_empty();
    test_utf8();
    test_bitmap_font();
}

fn love_load() {
    run();
    println("CLOVE_TEST_OK");
    love_event_quit();
}

fn main() {}
